Table reference.external_source_load {
  effective_end_date date [note: 'Date this version of the record ceased to be effective (Type-2 SCD end).']
  effective_start_date date [note: 'Date this version of the record became effective (Type-2 SCD start).']
  etl_process_name varchar [note: 'ETL process name matching the DLH inventory (e.g., Load_Acq_External_FDB_ALL_ALL_ALL).']
  external_source_load_id bigint [pk, note: 'Primary key for external_source_load']
  file_effective_date date [note: 'Effective date of the data in the file.']
  file_received_date date [note: 'Date the file was received.']
  is_current boolean [note: 'Flag indicating whether this is the current active version of the record (Type-2 SCD).']
  load_status varchar [note: 'Load status (success/partial/failed).']
  loaded_timestamp timestamp [note: 'Timestamp when the file was loaded.']
  medispan_drug_id bigint [ref: > reference.medispan_drug.medispan_drug_id, note: 'Reference to reference.medispan_drug.medispan_drug_id.']
  record_count bigint [note: 'Number of records in the file.']
  source_file_name varchar [note: 'Name of the loaded source file.']
  source_load_code bigint [note: 'Surrogate primary key for the source load record.']
  source_load_date date [note: 'Date on which this record was loaded from the external source feed.']
  source_load_id bigint [note: 'Surrogate PK for the source file load.']
  source_name varchar [note: 'Source feed name (FIRSTDATABANK/MEDISPAN/NCPDP/NPPES/NUCC).']
}

Table reference.fdb_drug {
  ahfs_code varchar [note: 'AHFS Pharmacologic-Therapeutic classification code.']
  desi_code varchar [note: 'Drug Efficacy Study Implementation rating.']
  effective_end_date date [note: 'Type-2 SCD effective end date for this version of the record.']
  effective_start_date date [note: 'Type-2 SCD effective start date for this version of the record.']
  fdb_drug_code varchar [note: 'FDB internal drug code (natural key).']
  fdb_drug_id bigint [pk, note: 'Surrogate primary key for the FDB drug record.']
  fdb_obsolete_date date [note: 'Date the drug was marked obsolete by FDB.']
  fdb_pregnancy_category varchar [note: 'FDB pregnancy category.']
  fdb_therapeutic_class_code varchar [note: 'FDB therapeutic class code.']
  fdb_therapeutic_class_description varchar [note: 'FDB therapeutic class description.']
  hic3_code varchar [note: 'Hierarchic Ingredient Code level 3.']
  hic3_description varchar [note: 'Description of the HIC3 ingredient group.']
  hicl_seqno varchar [note: 'HIC Labeler sequence number.']
  is_current boolean [note: 'True when this is the current active version of the record.']
  ndc11 varchar [note: '11-digit NDC.']
  ndc_code varchar [note: '11-digit FDA National Drug Code. Natural key for drug identification; not an FK.']
  ndc_id bigint [note: 'Add column ndc_id (BIGINT, FK to drug.ndc.ndc_id) to reference.fdb_drug. ndc_id (BIGINT, FK to drug.ndc.ndc_id)']
  routed_dosage_form_code varchar [note: 'FDB routed dosage form code.']
  routed_generic_drug_name varchar [note: 'Routed generic drug name.']
  source_file_name varchar [note: 'Name of the source file this record was ingested from.']
  source_load_date date [note: 'Date the source file was loaded into the platform.']
  strength_description varchar [note: 'Drug strength description.']
}

Table reference.fdb_drug_interaction {
  clinical_effect_description varchar [note: 'Description of the clinical effect of the interaction.']
  documentation_level varchar [note: 'Documentation level (established/probable/suspected/possible/unlikely).']
  drug_1_fdb_drug_code varchar [note: 'FDB drug code for the first interacting drug.']
  drug_1_ndc11 varchar [note: '11-digit NDC for the first interacting drug.']
  drug_2_fdb_drug_code varchar [note: 'FDB drug code for the second interacting drug.']
  drug_2_ndc11 varchar [note: '11-digit NDC for the second interacting drug.']
  effective_end_date date [note: 'Type-2 SCD effective end date for this version of the record.']
  effective_start_date date [note: 'Type-2 SCD effective start date for this version of the record.']
  fdb_drug_id bigint [ref: > reference.fdb_drug.fdb_drug_id, note: 'Reference to reference.fdb_drug.fdb_drug_id.']
  fdb_drug_interaction_id bigint [pk, note: 'Primary key for fdb_drug_interaction']
  fdb_interaction_code bigint [note: 'Surrogate primary key for the FDB interaction record.']
  fdb_interaction_id bigint [note: 'Surrogate PK for the FDB interaction pair.']
  interaction_class_code varchar [note: 'FDB interaction class code.']
  interaction_severity varchar [note: 'Interaction severity (major/moderate/minor).']
  is_current boolean [note: 'True when this is the current active version of the record.']
  management_description varchar [note: 'Recommended clinical management of the interaction.']
  onset_description varchar [note: 'Onset of the interaction (rapid/delayed/not specified).']
  source_file_name varchar [note: 'Name of the source file this record was ingested from.']
  source_load_date date [note: 'Date the source file was loaded into the platform.']
}

Table reference.fdb_pricing {
  awp_package_price decimal [note: 'Average Wholesale Price per package.']
  awp_unit_price decimal [note: 'Average Wholesale Price per unit.']
