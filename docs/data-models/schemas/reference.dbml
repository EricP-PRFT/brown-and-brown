  effective_end_date date [note: 'Type-2 SCD effective end date for this version of the record.']
  effective_start_date date [note: 'Type-2 SCD effective start date for this version of the record.']
  grouping varchar [note: 'Top-level provider grouping label from the NUCC Health Care Provider Taxonomy code set (e.g., Allopathic & Osteopathic Physicians). Sourced from nucc.org taxonomy release file.']
  is_current boolean [note: 'True when this is the current active version of the record.']
  nucc_taxonomy_id bigint [pk, note: 'Surrogate primary key for the NUCC taxonomy record.']
  source_file_name varchar [note: 'Name of the source file this record was ingested from.']
  source_load_date date [note: 'Date the source file was loaded into the platform.']
  specialization varchar [note: 'Sub-specialty within the NUCC classification (e.g., Cardiovascular Disease). Nullable — not all taxonomy codes carry a specialization. Represents the third level of the NUCC Health Care Provider Ta...']
  taxonomy_code varchar [unique, note: 'NUCC taxonomy code (unique natural key, e.g., 207R00000X).']
  taxonomy_version varchar [note: 'NUCC taxonomy code set release version identifier (e.g., 23.1). Tracks which published NUCC release this row was sourced from, enabling version-aware taxonomy lookups and audit of code-set changes ...']
}
