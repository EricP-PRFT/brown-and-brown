  effective_start_date date [note: 'Type-2 SCD effective start date for this version of the record.']
  fdb_drug_id bigint [ref: > reference.fdb_drug.fdb_drug_id, note: 'Reference to reference.fdb_drug.fdb_drug_id.']
  fdb_pricing_id bigint [pk, note: 'Surrogate primary key for the FDB pricing record.']
  federal_upper_limit_price decimal [note: 'Federal Upper Limit price.']
  is_current boolean [note: 'True when this is the current active version of the record.']
  ndc11 varchar [note: '11-digit NDC.']
  ndc_id bigint [note: 'FK to drug.ndc.ndc_id.']
  // cross-domain ref: ndc_id -> drug.ndc.ndc_id
  package_size decimal [note: 'Package size quantity.']
  package_size_unit varchar [note: 'Unit of the package size.']
  pricing_effective_date date [note: 'Effective date of the pricing record.']
  source_file_name varchar [note: 'Name of the source file this record was ingested from.']
  source_load_date date [note: 'Date the source file was loaded into the platform.']
  unit_dose_indicator boolean [note: 'True if the package is unit-dose.']
  wac_package_price decimal [note: 'Wholesale Acquisition Cost per package.']
  wac_unit_price decimal [note: 'Wholesale Acquisition Cost per unit.']
}

