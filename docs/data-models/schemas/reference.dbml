Table reference.nucc_taxonomy {
  classification varchar [note: 'Provider classification within the NUCC grouping (e.g., Internal Medicine). Represents the second level of the NUCC Health Care Provider Taxonomy hierarchy. Sourced from nucc.org taxonomy release f...']
