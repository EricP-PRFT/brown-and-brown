// DBML Schema for Business: Pillarrx
// Version: 1
// Generated on: 2026-10-16 20:55:45

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Pillarrx - Version 1'
}

// --- Tables ---

Table division.division {
  division_id varchar [pk, note: 'Unique identifier for the division data product (auto-inserted during validation).']
  company_pbm_id varchar [note: 'Reference to the primary PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) contracted to administer pharmacy benefits for this Division.']
  organization_id varchar [note: 'Reference to the parent Company in the Company > Division > Client hierarchy. Every Division belongs to exactly one Company.']
  bin_number varchar [note: 'Six-digit BIN used to route pharmacy claims to the correct PBM processor for this Division. Appears on member ID cards alongside PCN and RxGroup.']
  cap_enrolled boolean [note: 'Indicates whether this Division participates in PillarRx\'s Copay Assistance Program (CAP) managed via the PAX application for manufacturer copay card and coupon coordination.']
  consulting_tier varchar [note: 'PillarRx consulting service tier assigned to this Division, determining the scope of analytics, reporting, and advisory services delivered under the consulting engagement.']
  created_timestamp timestamp [note: 'Timestamp when this Division record was first created in the PillarRx platform. Used for audit trail, data lineage, and onboarding timeline tracking.']
  data_feed_format varchar [note: 'Format of the PBM claims data feed ingested for this Division. Drives ETL parsing logic in the PBM Claims Feed Ingestion Platform.']
  dir_applicable boolean [note: 'Indicates whether Direct and Indirect Remuneration (DIR) fees apply to this Division\'s pharmacy claims. Relevant for Medicare Part D and employer plans with DIR reconciliation.']
  division_code varchar [note: 'Externally-known alphanumeric code that uniquely identifies this Division within the parent Company. Used in PBM feeds, eligibility files, and client reporting as the stable business key.']
  division_name varchar [note: 'Human-readable name of the Division as known to the employer client and PillarRx consultants. Used in all client-facing reports and dashboards.']
  division_status varchar [note: 'Current lifecycle state of the Division within PillarRx. Controls whether eligibility, claims processing, and consulting services are active for this Division.']
  division_type varchar [note: 'Categorical classification of the Division indicating the nature of the covered population (e.g., active employees, union trust, retirees, COBRA continuants).']
  effective_date date [note: 'Date on which this Division became active and eligible for pharmacy benefit services under the PillarRx platform. Aligns with plan year start or client onboarding date.']
  erisa_plan_number varchar [note: 'Three-digit ERISA plan number assigned by the employer for Form 5500 reporting. Required for self-funded employer plans subject to DOL reporting obligations.']
  external_division_code varchar [note: 'Division identifier as assigned by the PBM or external eligibility system. Preserved for cross-system reconciliation and PBM feed matching alongside the internal surrogate key.']
  feed_frequency varchar [note: 'Frequency at which the PBM transmits pharmacy claims data for this Division to the PillarRx ingestion platform. Impacts data freshness for reporting and audit.']
  funding_type varchar [note: 'Indicates how the Division\'s pharmacy benefit is funded. Self-funded plans bear claim risk directly; fully insured plans pay premiums to a carrier. Drives audit and consulting scope.']
  medicare_part_d boolean [note: 'Indicates whether this Division includes Medicare Part D coverage (e.g., retiree drug subsidy or employer group waiver plan). Triggers CMS reporting and TrOOP accumulator rules.']
  member_count varchar [note: 'Current number of active members enrolled in this Division. Used for PMPM and PMPY calculations, capacity planning, and consulting benchmarking.']
  naics_code varchar [note: 'Six-digit NAICS code for the employer group. Complements SIC for industry benchmarking and peer-group analytics in PillarRx consulting deliverables.']
  notes varchar [note: 'Free-text field for consultant-entered notes about this Division, such as special contractual arrangements, audit findings, or onboarding considerations.']
  pbm_audit_frequency varchar [note: 'Contracted frequency at which PillarRx performs PBM performance audits (discount, rebate, dispensing fee guarantee reconciliation) for this Division.']
  pbm_group_code varchar [note: 'The RxGroup identifier assigned by the PBM to route pharmacy claims to this Division\'s benefit plan. Printed on member ID cards and used in NCPDP claim transactions.']
  pcn varchar [note: 'Processor Control Number used in conjunction with BIN to route pharmacy claims to the correct adjudication platform for this Division.']
  plan_year_start_month varchar [note: 'Calendar month (1–12) in which the Division\'s benefit plan year begins. Drives annual deductible resets, OOP accumulator resets, and PMPM/PMPY reporting periods.']
  prior_auth_program boolean [note: 'Indicates whether this Division has an active Prior Authorization (PA) program in place with the PBM. Drives PA analytics and audit scope within PillarRx consulting.']
  program_340b boolean [note: 'Indicates whether this Division participates in the HRSA 340B federal drug discount program, enabling covered entities to purchase outpatient drugs at significantly reduced prices.']
  quantity_limit_program boolean [note: 'Indicates whether Quantity Limit (QL) edits are active for this Division\'s benefit design, restricting the dispensed quantity per fill to clinically appropriate amounts.']
  rds_eligible boolean [note: 'Indicates whether this Division qualifies for the CMS Retiree Drug Subsidy (RDS) program, providing federal subsidy payments to employers maintaining retiree drug coverage.']
  rebate_pass_through boolean [note: 'Indicates whether manufacturer rebates collected by the PBM are passed through 100% to this Division (pass-through model) versus retained by the PBM (spread model).']
  sic_code varchar [note: 'Four-digit SIC code representing the industry of the employer group associated with this Division. Used for benchmarking pharmacy spend against industry peers.']
  specialty_carve_out boolean [note: 'Indicates whether specialty medications (SMN) are carved out to a separate specialty pharmacy or specialty PBM for this Division, separate from the primary PBM contract.']
  state_code varchar [note: 'Two-letter US state code representing the primary state of operation or situs for this Division. Drives state PBM licensure, transparency law compliance, and SPAP eligibility.']
  step_therapy_program boolean [note: 'Indicates whether Step Therapy (ST) protocols are active for this Division\'s benefit design, requiring members to try lower-cost alternatives before brand or specialty drugs.']
  tax_identification_number varchar [note: 'Federal Employer Identification Number (EIN) for the employer entity associated with this Division. Used in ERISA filings and PBM contract execution.']
  termination_date date [note: 'Date on which this Division was terminated or deactivated. Null for currently active Divisions. Used to scope eligibility and claims history.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this Division record. Used for change detection, ETL incremental loads, and audit trail purposes.']

  Note: 'DOMAIN: This domain owns the Division level of PillarRx\'s Company > Division > Client multi-tenant hierarchy and everything that logically scopes to a Division: benefit group designs, PBM contracts and their guarantee reconciliation lifecycle'
}

Table division.division_benefit_group {
  division_benefit_group_id varchar [pk, note: 'Unique surrogate identifier for a benefit group record within a division. Primary key for this entity.']
  benefit_plan_id varchar [note: 'Reference to the parent benefit plan under which this benefit group is offered. A plan may have multiple benefit groups representing different cost-sharing tiers.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that adjudicates claims for members enrolled in this benefit group.']
  division_formulary_id varchar [note: 'Reference to the formulary (covered drug list) associated with this benefit group. Determines which drugs are covered and at what tier for members in this group.']
  division_id varchar [note: 'Reference to the Division under which this benefit group is defined. Links to the org_division entity in the Company > Division > Client hierarchy.']
  employer_id varchar [note: 'Reference to the employer client whose plan members are enrolled in this benefit group. Scopes the benefit group to a specific employer within the division.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract governing pricing, guarantees, and service terms for this benefit group. Links to the client_pbm_contract entity for audit and benchmarking purposes.']
  pbm_division_id varchar [note: 'FK to division.pbm_division.pbm_division_id — Benefit groups are sponsored within a Division (VREQ-003: every benefit group scoped to the hierarchy). Required scoping FK.']
  accumulator_type varchar [note: 'Defines how pharmacy cost-sharing accumulators (deductible, OOP) are integrated with medical accumulators. \'integrated\' means pharmacy and medical share a single deductible/OOP pool; \'separate_rx\' means pharmacy has its own accumulator.']
  bin_number varchar [note: 'Six-digit Bank Identification Number (BIN / RxBIN) used to route pharmacy claims to the correct PBM processor at the point of sale. Required on the member ID card.']
  copay_assistance_applies boolean [note: 'Indicates whether manufacturer copay assistance program (CAP) payments count toward the member\'s deductible and OOP accumulator under this benefit group. Relevant for accumulator adjustment program (AAP) compliance.']
  daw_policy varchar [note: 'Plan-level Dispense As Written (DAW) policy governing whether brand drugs are covered when a generic equivalent exists. Drives member cost-share differentials and generic dispensing rate (GDR) targets.']
  deductible_family decimal(12,2) [note: 'Annual aggregate deductible amount for a family unit enrolled in this benefit group. Once met, all family members receive plan-paid benefits regardless of individual deductible status.']
  deductible_individual decimal(12,2) [note: 'Annual deductible amount that an individual member must satisfy before the plan begins paying drug costs. Expressed in USD. Zero indicates no deductible applies.']
  effective_date date [note: 'Date on which this benefit group becomes active and eligible for claim adjudication. Defines the start of the benefit group\'s coverage period.']
  group_code varchar [note: 'The RxGroup code transmitted on pharmacy claims to identify the benefit group. Used by the PBM for adjudication routing and benefit design lookup. Corresponds to the NCPDP RxGroup field.']
  group_description varchar [note: 'Detailed description of the benefit group, including eligibility criteria, population served, or plan design notes. Supports consulting analysis and client documentation.']
  group_name varchar [note: 'Human-readable name for the benefit group as defined by the employer or PBM (e.g., \'Active Employees\', \'Retirees\', \'COBRA Members\'). Used in reporting and member communications.']
  group_status varchar [note: 'Current lifecycle status of the benefit group. Controls whether new members can be enrolled and whether claims are adjudicated against this group\'s benefit design.']
  is_340b_eligible boolean [note: 'Indicates whether members in this benefit group are eligible for 340B federal drug discount pricing. Relevant for covered entities and contract pharmacies participating in the HRSA 340B program.']
  is_hdhp boolean [note: 'Indicates whether this benefit group is associated with a High Deductible Health Plan (HDHP), making members eligible for a Health Savings Account (HSA). Affects deductible thresholds and first-dollar coverage rules.']
  is_medicare_part_d boolean [note: 'Indicates whether this benefit group is a Medicare Part D plan. When true, TrOOP (True Out-of-Pocket) tracking and CMS reporting requirements apply.']
  mail_order_days_supply varchar [note: 'Standard days supply dispensed per fill for mail-order pharmacy under this benefit group (typically 90 days). Used in days-supply validation and cost-per-day analytics.']
  moop_family decimal(12,2) [note: 'Maximum Out-of-Pocket (MOOP) limit for a family unit, inclusive of all cost-sharing components. Used for total cost of care (TCOC) analysis and ACA compliance reporting.']
  moop_individual decimal(12,2) [note: 'Maximum Out-of-Pocket (MOOP) limit for an individual member, inclusive of all cost-sharing components (deductible, copay, coinsurance). Distinct from OOP max when plan design separates medical and pharmacy accumulators.']
  network_type varchar [note: 'Defines the pharmacy network access model for this benefit group. Determines which NCPDP-identified pharmacies are in-network and the cost-share differential for out-of-network dispensing.']
  oop_max_family decimal(12,2) [note: 'Maximum annual out-of-pocket (OOP) amount for a family unit. Once the family aggregate OOP is reached, the plan covers 100% of eligible drug costs for all family members.']
  oop_max_individual decimal(12,2) [note: 'Maximum annual out-of-pocket (OOP) amount an individual member pays for covered drugs. After this limit is reached, the plan covers 100% of eligible drug costs for the remainder of the plan year.']
  pcn varchar [note: 'Processor Control Number (RxPCN) used alongside BIN to route pharmacy claims to the correct sub-processor or benefit plan within the PBM. Printed on the member ID card.']
  plan_year_end_date date [note: 'End date of the benefit plan year for this group. Defines the accumulator reset boundary for deductible, OOP, and MOOP calculations.']
  plan_year_start_date date [note: 'Start date of the benefit plan year for this group. Determines when deductible, OOP, and MOOP accumulators reset. Typically January 1 for calendar-year plans.']
  prior_auth_required boolean [note: 'Indicates whether prior authorization (PA) is required for any drug class under this benefit group. When true, PA rules are enforced at adjudication for applicable NDCs.']
  quantity_limit_enforced boolean [note: 'Indicates whether quantity limits (QL) are enforced at adjudication for this benefit group. When true, dispensing quantities exceeding plan-defined limits require PA or are rejected.']
  record_created_timestamp timestamp [note: 'Timestamp when this benefit group record was first created in the PillarRx data platform. Used for audit trail and SCD Type-2 history management.']
  record_updated_timestamp timestamp [note: 'Timestamp when this benefit group record was last modified. Used for change detection, SCD Type-2 history tracking, and incremental ETL processing.']
  retail_days_supply varchar [note: 'Standard days supply dispensed per fill at retail pharmacy under this benefit group (typically 30 days). Used in days-supply validation and channel-mix analytics.']
  retiree_drug_subsidy_eligible boolean [note: 'Indicates whether this benefit group qualifies for the CMS Retiree Drug Subsidy (RDS) program. When true, the employer may receive federal subsidy payments for qualifying retiree drug costs.']
  source_group_code varchar [note: 'The raw benefit group code as received from the source system or PBM feed before normalization. Preserved for reconciliation and audit traceability against PBM claim files.']
  specialty_drug_policy varchar [note: 'Plan-level policy governing how specialty medications (SMN) are covered under this benefit group. Drives specialty pharmacy channel requirements, prior authorization (PA), and step therapy (ST) rules.']
  specialty_pharmacy_required boolean [note: 'Indicates whether specialty medications must be dispensed through a designated specialty pharmacy. When true, retail dispensing of specialty drugs is not covered under this benefit group.']
  step_therapy_required boolean [note: 'Indicates whether step therapy (ST) protocols are enforced for this benefit group. When true, members must try preferred drugs before coverage of non-preferred alternatives is approved.']
  termination_date date [note: 'Date on which this benefit group is no longer active. Null for open-ended groups. Used for Type-2 SCD history and eligibility validation.']

  Note: 'Defines a named benefit group (BG) within a Division, representing a distinct pharmacy benefit design offered to a subset of members under a Client plan. Captures the benefit group code (RxGroup), BIN, PCN, DAW policy, specialty drug policy, OOP/MOOP'
}

Table division.division_pbm_contract {
  division_pbm_contract_id varchar [pk, note: 'Unique surrogate identifier for a PBM contract record negotiated on behalf of a Division or Client. Primary key for this entity. Role: MASTER_AGREEMENT.']
  company_pbm_id varchar [note: 'Reference to the PBM entity (CVS Caremark, Optum Rx, Express Scripts, etc.) that is the counterparty to this contract.']
  division_id varchar [note: 'Reference to the Division within the Company > Division > Client hierarchy that is the contracting party or oversight entity for this PBM contract.']
  employer_id varchar [note: 'Reference to the specific employer Client whose health plan is governed by this PBM contract. Nullable when the contract is negotiated at the Division level covering multiple clients.']
  pbm_division_id varchar [note: 'FK to division.pbm_division.pbm_division_id — Every PBM contract is negotiated on behalf of a Division; contract must point to its owning division per VREQ-003 scoping.']
  admin_fee_pmpm decimal(10,4) [note: 'Contracted PBM administrative fee charged per member per month (PMPM) for plan administration services. Distinct from dispensing fees; a fixed overhead cost component.']
  audit_lookback_months varchar [note: 'Number of months prior to the audit request date for which the plan sponsor may audit PBM claims and pricing under the contract terms.']
  audit_rights_indicator boolean [note: 'Indicates whether the contract grants the plan sponsor (employer) the right to audit PBM claims data, pricing, and rebate calculations. Essential for PillarRx audit engagements.']
  auto_renewal_indicator boolean [note: 'Indicates whether the contract automatically renews at the end of the contract term unless notice of termination is provided by either party.']
  bin_number varchar [note: 'Six-digit Bank Identification Number (BIN / RxBIN) used to route pharmacy claims to the correct PBM processor at the point of sale. Required for claims adjudication.']
  brand_awp_discount_pct decimal(7,4) [note: 'Contracted percentage discount off AWP for brand-name drugs dispensed at retail pharmacies. Core audit metric for PBM guarantee reconciliation.']
  clinical_program_fee_pmpm decimal(10,4) [note: 'Contracted fee per member per month (PMPM) for PBM-managed clinical programs such as Drug Utilization Review (DUR), MTM, or prior authorization management.']
  contract_document_url varchar [note: 'URL or path reference to the executed contract document stored in the document management system. Enables auditors and consultants to access the source agreement.']
  contract_name varchar [note: 'Human-readable name or short description of the PBM contract (e.g., \'Acme Corp CVS Caremark 2024 Agreement\'). Used for display and reporting.']
  contract_number varchar [note: 'Externally-known contract number or agreement identifier assigned by the PBM or the contracting party. Used for audit, correspondence, and reconciliation with the PBM.']
  contract_status varchar [note: 'Current lifecycle state of the PBM contract. Drives eligibility for claims processing, audit activities, and reporting inclusion.']
  contract_type varchar [note: 'Classification of the PBM pricing model. Pass-through contracts expose actual drug costs; spread contracts allow PBM margin; ASO contracts are fee-only. Critical for audit and benchmarking.']
  contract_version varchar [note: 'Version or amendment number of the contract document (e.g., \'1.0\', \'2.1\', \'Amendment 3\'). Tracks the evolution of contract terms over time.']
  created_timestamp timestamp [note: 'Timestamp when this PBM contract record was first created in the system. Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this contract record. Typically USD for domestic employer-sponsored plans.']
  dir_fee_indicator boolean [note: 'Indicates whether Direct and Indirect Remuneration (DIR) fees apply under this contract. DIR fees are post-point-of-sale adjustments that affect net pharmacy reimbursement.']
  effective_date date [note: 'Date on which the PBM contract becomes binding and claims processing under its terms begins. Aligns with plan year start in most employer-sponsored plans.']
  execution_date date [note: 'Date on which the PBM contract was fully executed (signed by all parties). May differ from the effective date when contracts are signed retroactively.']
  formulary_type varchar [note: 'Classification of the formulary structure under this contract. Open formularies cover all drugs; closed formularies restrict to a defined list; incentive formularies use tiered cost-sharing.']
  gdr_guarantee_pct decimal(7,4) [note: 'Contracted minimum Generic Dispensing Rate (GDR) guaranteed by the PBM. Failure to meet this threshold may trigger financial penalties or credits under the contract.']
  generic_awp_discount_pct decimal(7,4) [note: 'Contracted percentage discount off AWP for generic drugs dispensed at retail pharmacies. Used in Generic Dispensing Rate (GDR) and savings analysis.']
  guaranteed_rebate_pmpm decimal(10,4) [note: 'Minimum guaranteed rebate amount per member per month (PMPM) committed by the PBM under this contract. Used in rebate reconciliation and guarantee auditing.']
  mail_brand_awp_discount_pct decimal(7,4) [note: 'Contracted AWP discount percentage for brand-name drugs dispensed through mail-order pharmacy. Typically higher than retail brand discount.']
  mail_dispensing_fee decimal(10,4) [note: 'Contracted flat dispensing fee (in USD) paid per mail-order prescription fill. Mail dispensing fees are typically lower than retail due to volume efficiencies.']
  mail_generic_awp_discount_pct decimal(7,4) [note: 'Contracted AWP discount percentage for generic drugs dispensed through mail-order pharmacy. Used in mail-order savings and GDR analysis.']
  member_id_prefix varchar [note: 'Prefix applied to member identifiers under this PBM contract. Used during Member 360 identity resolution to distinguish PBM-specific member ID formats across sources.']
  notes varchar [note: 'Free-text field for consultant or analyst annotations regarding contract terms, negotiation history, exceptions, or audit findings not captured in structured fields.']
  pcn varchar [note: 'Processor Control Number (RxPCN) used in conjunction with BIN to route pharmacy claims to the correct PBM sub-processor or benefit plan. Required for claims adjudication.']
  performance_guarantee_indicator boolean [note: 'Indicates whether the PBM contract includes performance guarantees (e.g., GDR targets, clinical program outcomes, member satisfaction). Triggers guarantee reconciliation workflows.']
  plan_type varchar [note: 'Type of health plan covered by this PBM contract. Determines applicable regulatory framework (ERISA for commercial, CMS for Medicare Part D, etc.).']
  pricing_model varchar [note: 'The drug ingredient cost pricing methodology specified in the contract. Determines how pharmacy reimbursement is calculated (e.g., AWP Discount, MAC, Guaranteed Effective Rate).']
  rebate_pass_through_indicator boolean [note: 'Indicates whether manufacturer rebates collected by the PBM are passed through 100% to the plan (True) or retained partially by the PBM as spread (False). Critical transparency metric.']
  renewal_notice_days varchar [note: 'Number of days prior to contract termination date by which either party must provide written notice to prevent auto-renewal or to initiate termination.']
  retail_dispensing_fee decimal(10,4) [note: 'Contracted flat dispensing fee (in USD) paid to retail pharmacies per prescription fill under this PBM contract. A key component of total pharmacy reimbursement.']
  rx_group varchar [note: 'Pharmacy benefit group identifier (RxGroup) printed on the member ID card. Used by pharmacies to identify the benefit plan and apply correct cost-sharing at adjudication.']
  specialty_awp_discount_pct decimal(7,4) [note: 'Contracted percentage discount off AWP for specialty medications (SMN). Specialty spend is a primary cost driver and this rate is a key audit guarantee.']
  spread_pricing_indicator boolean [note: 'Indicates whether the PBM retains a spread (difference between plan-paid amount and pharmacy reimbursement). False for pass-through contracts. Key audit and transparency flag.']
  termination_date date [note: 'Date on which the PBM contract ends or is terminated. Nullable for open-ended contracts. Claims with a Date of Service (DOS) after this date are out-of-contract.']
  updated_timestamp timestamp [note: 'Timestamp when this PBM contract record was last modified. Used for change tracking, ETL incremental loads, and audit trail purposes.']

  Note: 'Master record for a PBM contract negotiated on behalf of a Division or Client. Captures the contracted PBM name, contract effective and termination dates, pricing model type (pass-through vs.'
}

Table division.pbm_guarantee_period {
  pbm_guarantee_period_id varchar [pk, note: 'Unique surrogate identifier for a PBM guarantee period record. Primary key for this entity.']
  company_pbm_id varchar [note: 'Reference to the PBM entity (e.g., CVS Caremark, Optum Rx, Express Scripts) whose performance guarantees are being measured in this period.']
  division_pbm_contract_id varchar [note: 'Reference to the PBM contract under which this guarantee period is evaluated. Links the period to its governing contract terms.']
  employer_id varchar [note: 'Reference to the employer client whose pharmacy spend is subject to PBM performance guarantees during this period.']
  actual_member_months varchar [note: 'Actual number of member months recorded during this guarantee period. Used as the denominator for PMPM calculations and to validate eligibility for guarantee measurement.']
  audit_completion_date date [note: 'Date on which the PBM performance audit for this guarantee period was completed and findings were finalized. Used to track consulting engagement timelines.']
  audit_status varchar [note: 'Current status of the PBM performance audit for this guarantee period. Tracks PillarRx consulting audit workflow from initiation through findings delivery to the client.']
  awp_discount_guarantee_brand decimal(7,4) [note: 'Contractually guaranteed AWP discount percentage for brand drugs during this period. Expressed as a decimal (e.g., 0.1800 = 18.00%). Baseline for PBM audit.']
  awp_discount_guarantee_generic decimal(7,4) [note: 'Contractually guaranteed AWP discount percentage for generic drugs during this period. Expressed as a decimal (e.g., 0.8500 = 85.00%). Baseline for PBM audit.']
  awp_discount_guarantee_specialty decimal(7,4) [note: 'Contractually guaranteed AWP discount percentage for specialty drugs during this period. Expressed as a decimal. Specialty spend is a primary driver of total pharmacy cost.']
  ber_guarantee decimal(7,4) [note: 'Brand Effective Rate (BER) guarantee for this period, representing the blended net cost per brand claim after all discounts and rebates. Expressed as a decimal.']
  client_report_delivered_date date [note: 'Actual date on which the guarantee period performance report was delivered to the employer client. Used to measure consulting engagement timeliness and SLA adherence.']
  client_report_due_date date [note: 'Date by which PillarRx must deliver the guarantee period performance report to the employer client. Drives consulting engagement scheduling and deliverable tracking.']
  contract_fk varchar [note: 'FK to division.pbm_contract.pbm_contract_id — A guarantee period measures a specific PBM contract; parent FK required for reconciliation chain.']
  contract_year_number varchar [note: 'Sequential year number within the PBM contract term (e.g., Year 1, Year 2, Year 3). Used to track guarantee escalation schedules and multi-year contract performance.']
  created_timestamp timestamp [note: 'Timestamp when this guarantee period record was first created in the system. Supports audit trail and data lineage requirements.']
  dir_applicable_indicator boolean [note: 'Indicates whether Direct and Indirect Remuneration (DIR) fees apply during this guarantee period. DIR fees affect net drug cost and are subject to CMS regulatory scrutiny.']
  dispensing_fee_guarantee_mail decimal(10,4) [note: 'Maximum guaranteed dispensing fee per mail-order claim for this period. Expressed in USD. Mail-order dispensing fees are typically lower than retail on a per-fill basis.']
  dispensing_fee_guarantee_retail decimal(10,4) [note: 'Maximum guaranteed dispensing fee per retail claim for this period. Expressed in USD. Compared against actual dispensing fees paid to assess PBM compliance.']
  dispute_description varchar [note: 'Narrative description of the nature of the dispute, including the specific guarantee metric(s) contested and the basis for the disagreement with the PBM.']
  dispute_indicator boolean [note: 'Indicates whether the client or PillarRx has formally disputed the PBM\'s performance results or remediation position for this guarantee period.']
  end_date date [note: 'Last date of the measurement window for PBM performance guarantee evaluation. Claims with a date of service within start_date and end_date are included.']
  evaluation_year varchar [note: 'Calendar or plan year (e.g., 2024) associated with this guarantee period. Supports year-over-year trend analysis and annual reconciliation reporting.']
  gdr_guarantee decimal(7,4) [note: 'Minimum guaranteed Generic Dispensing Rate (GDR) for this period. Expressed as a decimal (e.g., 0.8800 = 88.00%). Low GDR may indicate formulary or substitution issues.']
  ger_guarantee decimal(7,4) [note: 'Guaranteed Effective Rate (GER) for brand drugs, representing the net effective AWP discount after rebates for this period. Expressed as a decimal. Key PBM audit metric.']
  guarantee_period_contract_fk varchar [note: 'FK to division.pbm_contract.pbm_contract_id — A guarantee period is \'evaluated against a specific PBM contract\' — this transaction->master FK is the backbone of the reconciliation chain and no engineer would ship without it.']
  guarantee_period_pbm_contract_fk varchar [note: 'FK to division.pbm_contract.pbm_contract_id — Each guarantee period evaluates a specific PBM contract. Transaction->master link required for reconciliation lineage.']
  guarantee_shortfall_amount decimal(18,2) [note: 'Dollar amount by which the PBM failed to meet financial guarantees during this period. Expressed in USD. Positive value indicates a shortfall owed to the client by the PBM.']
  mac_guarantee_indicator boolean [note: 'Indicates whether a Maximum Allowable Cost (MAC) pricing guarantee applies to this period. When true, the PBM is contractually bound to a specific MAC list and pricing methodology.']
  measurement_basis varchar [note: 'Defines the claim population used to measure PBM performance against guarantees (e.g., paid claims net of reversals). Ensures consistent audit methodology.']
  minimum_member_months varchar [note: 'Minimum number of member months required for the guarantee period to be eligible for performance measurement. Protects against small-sample distortions in guarantee calculations.']
  notes varchar [note: 'Free-text field for analyst or consultant notes regarding this guarantee period, such as methodology exceptions, PBM communications, or client-specific context.']
  pass_through_indicator boolean [note: 'Indicates whether the PBM contract for this period operates on a pass-through (transparent) pricing model. Pass-through contracts eliminate spread pricing and require full rebate disclosure.']
  pbm_contract_fk varchar [note: 'FK to division.pbm_contract.pbm_contract_id — A guarantee measurement period is evaluated against a specific PBM contract; master->period lineage required for variance tracing.']
  pbm_data_received_date date [note: 'Actual date on which PBM claims data and performance reports were received by PillarRx for this guarantee period. Compared against submission deadline for compliance tracking.']
  pbm_submission_deadline date [note: 'Contractual deadline by which the PBM must submit claims data and performance reports for this guarantee period. Missed deadlines may trigger contract remedies.']
  period_name varchar [note: 'Human-readable label for the guarantee period, such as \'CY2024 Annual Guarantee Period\' or \'2024 H1 Semi-Annual Review\'. Used in reporting and client deliverables.']
  period_status varchar [note: 'Current lifecycle state of the guarantee period. Drives workflow routing for audit, reconciliation, and client reporting activities.']
  period_type varchar [note: 'Classification of the measurement cadence for this guarantee period. Drives how performance results are aggregated and reported to the client.']
  rebate_guarantee_pmpm decimal(10,4) [note: 'Minimum guaranteed rebate amount per member per month (PMPM) for this period. Expressed in USD. Used to assess whether PBM rebate pass-through meets contractual minimums.']
  remediation_amount decimal(18,2) [note: 'Dollar amount agreed upon or paid by the PBM to remediate guarantee shortfalls for this period. Expressed in USD. May differ from shortfall_amount after negotiation.']
  remediation_status varchar [note: 'Current status of the remediation process for any guarantee shortfall identified in this period. Tracks the resolution lifecycle from identification through payment or waiver.']
  start_date date [note: 'First date of the measurement window during which PBM performance guarantees are evaluated. Aligns with the contract year or sub-period definition.']
  total_claim_count varchar [note: 'Total number of pharmacy claims included in the guarantee period measurement population. Used to validate statistical significance and support PBM audit reconciliation.']
  total_drug_spend decimal(18,2) [note: 'Total plan-paid drug spend (ingredient cost plus dispensing fees) during this guarantee period. Expressed in USD. Primary financial baseline for guarantee reconciliation.']
  total_rebates_received decimal(18,2) [note: 'Total rebate dollars received from the PBM during this guarantee period. Expressed in USD. Compared against rebate guarantee to identify shortfalls requiring remediation.']
  updated_timestamp timestamp [note: 'Timestamp when this guarantee period record was last modified. Used to detect stale records and support incremental ETL processing in the Databricks lakehouse.']

  Note: 'Defines a discrete measurement period (typically annual or semi-annual) during which PBM performance guarantees are evaluated against a specific PBM contract.'
}

Table division.pbm_guarantee_result {
  pbm_guarantee_result_id varchar [pk, note: 'Unique surrogate identifier for a PBM guarantee reconciliation result record. Primary key for this entity. Role: TRANSACTION_HEADER.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) against whose contractual guarantee this result is measured.']
  employer_id varchar [note: 'Reference to the employer client whose PBM guarantee is being reconciled. Supports multi-tenant scoping within the Company > Division > Client hierarchy.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract that defines the guarantee terms being evaluated. Ties the result to the governing contractual agreement.']
  pbm_guarantee_period_id varchar [note: 'FK to division.pbm_guarantee_period.pbm_guarantee_period_id — Each result row is \'the outcome of a PBM guarantee reconciliation for a specific guarantee period\' — mandatory header->line FK.']
  pbm_period_fk varchar [note: 'FK to division.pbm_guarantee_period.pbm_guarantee_period_id — Each result rolls up to its guarantee period; without this the reconciliation chain cannot be traced for variance root-cause.']
  primary_pbm_guarantee_period_id varchar [note: 'Reference to the parent PBM guarantee period under which this result was evaluated. Links result to its measurement window and contract context.']
  actual_value decimal(18,6) [note: 'The actual measured value achieved by the PBM for the guarantee metric during the evaluation period. Compared against guaranteed_value to determine pass/fail.']
  awp_basis decimal(18,2) [note: 'Total AWP of drugs in the evaluation population. Used as the denominator for AWP discount guarantee calculations and PBM audit benchmarking.']
  channel_type varchar [note: 'Pharmacy dispensing channel scope for this guarantee result (retail, mail order, specialty, or all channels combined). Affects benchmark applicability.']
  claim_count varchar [note: 'Number of pharmacy claims included in the guarantee evaluation population for this result. Used to validate statistical significance and audit scope.']
  created_timestamp timestamp [note: 'Timestamp when this guarantee result record was first captured in the system. Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this record. Typically USD for PillarRx domestic employer clients.']
  dir_included boolean [note: 'Indicates whether Direct and Indirect Remuneration (DIR) fees are included in the guarantee calculation. Affects net effective discount and plan cost analysis.']
  dispute_date date [note: 'Date on which the formal dispute was filed against this guarantee result. Establishes the dispute timeline for resolution tracking and SLA monitoring.']
  dispute_reason varchar [note: 'Narrative explanation of the basis for disputing this guarantee result. Captured when is_disputed is True; used in PBM correspondence and audit documentation.']
  drug_category varchar [note: 'Drug classification scope to which this guarantee result applies. Determines whether the metric covers brand, generic, specialty, or all drug categories.']
  evaluation_date date [note: 'The date on which the guarantee metric was formally evaluated and this result record was produced. Principal business event date for this transaction.']
  ger_applicable boolean [note: 'Indicates whether a Guaranteed Effective Rate (GER) applies to this guarantee metric. GER guarantees a blended effective discount rate across the drug mix.']
  guarantee_metric_code varchar [note: 'Standardized code identifying the specific guarantee metric being evaluated (e.g., AWP_DISCOUNT_BRAND, GDR, DISPENSING_FEE, REBATE_GUARANTEE). Drives reporting categorization.']
  guarantee_metric_name varchar [note: 'Human-readable name of the guarantee metric being evaluated (e.g., \'Brand AWP Discount\', \'Generic Dispensing Rate\', \'Dispensing Fee Guarantee\'). Used in client reports.']
  guarantee_type varchar [note: 'Classification of the guarantee category. Segments results by the type of PBM contractual commitment being audited (e.g., discount, dispensing fee, rebate, GDR).']
  guaranteed_value decimal(18,6) [note: 'The contractually committed guarantee threshold value (e.g., AWP discount percentage, dispensing fee cap, GDR target). Expressed in the unit defined by guarantee_metric_code.']
  is_disputed boolean [note: 'Indicates whether the PBM or client has formally disputed this guarantee result. Triggers dispute workflow and holds remedy payment pending resolution.']
  is_pass boolean [note: 'Boolean flag indicating whether the PBM met the contractual guarantee threshold. True = guarantee met; False = guarantee missed and remedy may apply.']
  is_reconciled boolean [note: 'Indicates whether this guarantee result has been fully reconciled, including remedy payment receipt and client sign-off. Closes the audit cycle for this metric.']
  metric_unit varchar [note: 'Unit of measure for the guarantee metric values (guaranteed_value, actual_value, variance_value). Enables correct interpretation of numeric results across different metric types.']
  notes varchar [note: 'Free-text notes capturing analyst observations, PBM communications, or contextual details about this guarantee result. Used in consulting deliverables and audit documentation.']
  pbm_report_reference varchar [note: 'Reference number or name of the PBM-issued performance report from which pbm_reported_value was sourced. Supports audit traceability back to PBM documentation.']
  pbm_reported_value decimal(18,6) [note: 'The guarantee metric value as self-reported by the PBM in their performance report. Compared to actual_value (PillarRx-calculated) to identify discrepancies for audit.']
  period_end_date date [note: 'End date of the measurement period covered by this guarantee result. Denormalized from the parent guarantee period for reporting convenience.']
  period_start_date date [note: 'Start date of the measurement period covered by this guarantee result. Denormalized from the parent guarantee period for reporting convenience.']
  reconciliation_date date [note: 'Date on which this guarantee result was marked as fully reconciled. Null if is_reconciled is False. Used for period-close reporting.']
  remedy_amount decimal(18,2) [note: 'Dollar amount owed by the PBM to the client as a financial remedy for failing to meet the guarantee. Zero if the guarantee was met or waived.']
  remedy_due_date date [note: 'Contractually required date by which the PBM must remit the remedy payment to the client. Drives accounts receivable follow-up and PBM performance tracking.']
  remedy_paid_amount decimal(18,2) [note: 'Dollar amount actually received from the PBM as remedy payment. May differ from remedy_amount if disputed or partially settled.']
  remedy_received_date date [note: 'Date on which the PBM remedy payment was actually received by the client. Compared to remedy_due_date to identify late payments.']
  remedy_variance_amount decimal(18,2) [note: 'Difference between remedy_amount and remedy_paid_amount. Tracks outstanding or disputed remedy balances for follow-up and client reporting.']
  resolution_date date [note: 'Date on which a disputed guarantee result was formally resolved. Null if dispute is still open. Used to measure dispute cycle time.']
  result_number varchar [note: 'Externally-known business identifier for this guarantee result record, used in client deliverables, audit reports, and PBM correspondence.']
  result_status varchar [note: 'Current lifecycle status of the guarantee result. Indicates whether the PBM met, missed, or is under review for the evaluated guarantee metric.']
  source_file_name varchar [note: 'Name of the source data file from which this guarantee result was loaded or derived. Supports ETL lineage, reprocessing, and audit traceability.']
  total_drug_spend decimal(18,2) [note: 'Total pharmacy drug spend included in the guarantee evaluation population. Provides financial context for the scale of the guarantee measurement.']
  updated_timestamp timestamp [note: 'Timestamp when this guarantee result record was last modified. Tracks revisions from dispute resolution, restatements, or PBM data corrections.']
  variance_value decimal(18,6) [note: 'Difference between actual_value and guaranteed_value. Positive variance indicates PBM outperformed; negative indicates underperformance and potential financial remedy.']

  Note: 'Transactional record capturing the outcome of a PBM guarantee reconciliation for a specific guarantee period and metric. References its parent pbm_guarantee_period.'
}

Table division.division_formulary {
  division_formulary_id varchar [pk, note: 'Unique surrogate identifier for the formulary record in the PillarRx data lakehouse. Primary key for the formulary dimension.']
  company_pbm_id varchar [note: 'FK to company.pbm']
  employer_id varchar [note: 'Reference to the employer client whose benefit plan uses this formulary. Supports multi-tenant scoping within the Company > Division > Client hierarchy.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract under which this formulary is administered. Links the formulary to the division-level PBM contract.']
  pbm_formulary_division_formulary_id varchar [note: 'The formulary identifier assigned by the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts). Used to cross-reference formulary data in PBM claims feeds and audit reconciliation.']
  brand_drug_count varchar [note: 'Number of brand-name drug products listed on this formulary. Used alongside generic drug count to assess formulary composition and Generic Dispensing Rate (GDR) potential.']
  division_formulary_description varchar [note: 'Free-text description of the formulary, including notable design features, coverage restrictions, or plan sponsor customizations. Used in consulting deliverables and client documentation.']
  division_formulary_name varchar [note: 'Human-readable name of the formulary as defined by the PBM or plan sponsor (e.g., \'Standard 4-Tier Formulary\', \'Preferred Drug List\'). Used in client reporting and consulting deliverables.']
  division_formulary_status varchar [note: 'Current lifecycle state of the formulary. Active formularies are in use for claims adjudication. Superseded formularies have been replaced by a newer version. Supports Type-2 SCD history.']
  division_formulary_type varchar [note: 'Classification of the formulary structure. Open: any drug covered; Closed: only listed drugs covered; Incentive: cost-sharing differentials encourage preferred drugs; Exclusive/Managed: restricted access.']
  drug_count varchar [note: 'Total number of National Drug Codes (NDCs) or drug products listed on this formulary. Used as a benchmarking metric in PBM consulting analysis to assess formulary breadth and coverage.']
  effective_date date [note: 'Date on which this formulary version becomes effective for claims adjudication. Used to determine which formulary applies to a given Date of Service (DOS).']
  excluded_drug_count varchar [note: 'Number of drugs explicitly excluded from coverage on this formulary. Exclusions are a key PBM cost-management lever and are audited for compliance with plan sponsor agreements.']
  expiration_date date [note: 'Date on which this formulary version expires and is no longer applicable for new claims. Null indicates an open-ended formulary with no defined end date.']
  generic_drug_count varchar [note: 'Number of generic drug products listed on this formulary. Used to assess Generic Dispensing Rate (GDR) potential and formulary design effectiveness in driving cost-efficient dispensing.']
  generic_preferred_indicator boolean [note: 'Indicates whether this formulary design preferentially places generic drugs on lower-cost tiers to drive Generic Dispensing Rate (GDR). Key attribute for PBM audit and benchmarking analysis.']
  is_current_record boolean [note: 'Indicates whether this row is the current active version of the formulary in the Type-2 SCD history (True = current). Simplifies queries that need only the latest formulary state.']
  mail_order_indicator boolean [note: 'Indicates whether this formulary includes mail-order pharmacy benefit provisions (True). Mail-order formularies may carry different tier placements and dispensing fee structures than retail.']
  notes varchar [note: 'Free-text field for analyst or consultant notes regarding this formulary, such as mid-year changes, plan sponsor exceptions, or PBM audit findings. Not used in automated processing.']
  pass_through_indicator boolean [note: 'Indicates whether this formulary operates under a pass-through PBM pricing model where rebates and discounts are fully passed to the plan sponsor, as opposed to a spread pricing model.']
  plan_year varchar [note: 'The benefit plan year (e.g., 2024) to which this formulary applies. Used to align formulary versions with annual plan renewals and PBM contract performance guarantee periods.']
  prior_auth_indicator boolean [note: 'Indicates whether this formulary requires prior authorization (PA) for any covered drugs. PA requirements are tracked for PBM audit and member affordability analysis.']
  quantity_limit_indicator boolean [note: 'Indicates whether this formulary applies quantity limit (QL) edits to covered drugs. Quantity limits restrict the dispensed amount per fill or per period to clinically appropriate levels.']
  rebate_eligible_indicator boolean [note: 'Indicates whether drugs on this formulary are eligible for manufacturer rebates. Rebate eligibility is a critical factor in PBM contract guarantee reconciliation and pass-through analysis.']
  scd_effective_date date [note: 'Start date of this formulary record\'s validity window in the Type-2 slowly changing dimension (SCD) history. Enables point-in-time formulary lookups for claims audit and trend analysis.']
  scd_expiration_date date [note: 'End date of this formulary record\'s validity window in the Type-2 SCD history. Null or 9999-12-31 indicates the current active record. Enables historical formulary reconstruction for PBM audits.']
  source varchar [note: 'Identifies the source system or data feed from which this formulary record was ingested (e.g., PBM claims feed, manual upload, eligibility system). Supports data lineage and audit traceability.']
  specialty_drug_count varchar [note: 'Number of specialty medications (SMN) listed on this formulary. Used in specialty pharmacy spend monitoring and trend reporting for employer clients.']
  specialty_formulary_indicator boolean [note: 'Indicates whether this formulary is a specialty drug formulary (True) or a standard formulary (False). Specialty formularies govern high-cost specialty medications (SMN) and limited distribution drugs (LDD).']
  step_therapy_indicator boolean [note: 'Indicates whether this formulary enforces step therapy (ST) protocols requiring members to try preferred drugs before accessing non-preferred alternatives. Relevant to prior authorization (PA) analysis.']
  tier_count varchar [note: 'Total number of cost-sharing tiers defined in this formulary (e.g., 3-tier, 4-tier, 5-tier). Drives member cost-share structure and is a key benchmarking dimension in PBM consulting analysis.']
  url varchar [note: 'Public or internal URL where the formulary drug list is published or accessible. Used for member communication, plan document references, and consulting deliverable links.']
  version varchar [note: 'Version identifier for this formulary, as assigned by the PBM or plan sponsor (e.g., \'v2024.1\', \'2024Q1\'). Supports Type-2 slowly changing dimension (SCD) history tracking across formulary updates.']

  Note: 'Master record for a drug formulary (covered drug list) associated with a benefit group and PBM contract. Captures the formulary name, formulary ID assigned by the PBM, effective date range, formulary type (open, closed, incentive), number of tiers'
}

Table division.division_formulary_tier {
  division_formulary_tier_id varchar [pk, note: 'Unique surrogate identifier for a formulary tier record. Primary key for the formulary_tier dimension in the PillarRx analytics lakehouse.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that administers this formulary tier on behalf of the client.']
  division_formulary_id varchar [note: 'Reference to the parent formulary to which this tier belongs. Links the tier to its governing covered drug list.']
  employer_id varchar [note: 'Reference to the employer client whose benefit plan uses this formulary tier. Supports multi-tenant scoping within the Company > Division > Client hierarchy.']
  accumulator_program_applies boolean [note: 'Indicates whether a copay accumulator adjustment program (CAAP) is active for this tier, preventing manufacturer copay assistance from counting toward member deductible or MOOP.']
  brand_indicator boolean [note: 'Indicates whether this tier is designated for brand-name drugs. Supports Brand Effective Rate (BER) and AWP discount guarantee auditing.']
  coinsurance_pct decimal(5,4) [note: 'Member\'s percentage share of the drug cost at this tier after deductible (e.g., 0.20 = 20%). Null when the tier uses a flat copay instead of coinsurance.']
  copay_amount decimal(10,2) [note: 'Fixed dollar amount the member pays per prescription fill at this tier (e.g., $10 for Generic, $40 for Preferred Brand). Zero if coinsurance-only tier.']
  coverage_type varchar [note: 'Indicates the dispensing channel to which this tier definition applies: retail (30-day), mail (90-day), specialty pharmacy, or both retail and mail.']
  created_timestamp timestamp [note: 'Timestamp when this formulary tier record was first created in the PillarRx lakehouse. Supports audit trail and data governance requirements.']
  days_supply_limit varchar [note: 'Maximum days supply allowed per fill at this tier (e.g., 30 for retail, 90 for mail). Enforced during adjudication and used in quantity limit analysis.']
  deductible_applies boolean [note: 'Indicates whether the plan deductible must be satisfied before this tier\'s copay or coinsurance applies. True for most brand tiers; often False for generic tiers.']
  division_formulary_tier_name varchar [note: 'Full descriptive name of the tier as defined by the PBM or plan sponsor (e.g., \'Tier 1 - Preferred Generic\'). May differ from tier_label when PBMs use custom naming.']
  effective_date date [note: 'Date on which this formulary tier definition becomes effective for adjudication. Supports Type-2 slowly changing dimension (SCD) history tracking.']
  expiration_date date [note: 'Date on which this formulary tier definition expires or is superseded. Null for currently active tiers. Supports SCD Type-2 history in the drug formulary dimension.']
  formulary_exception_allowed boolean [note: 'Indicates whether members may request a formulary exception to obtain a non-formulary drug at this tier\'s cost share. Required for CMS Part D compliance.']
  generic_indicator boolean [note: 'Indicates whether this tier is designated for generic drugs. Used in Generic Dispensing Rate (GDR) analysis and PBM performance benchmarking.']
  is_current boolean [note: 'Type-2 SCD flag indicating whether this is the currently active version of the formulary tier record. True for the current row; False for historical rows.']
  mail_coinsurance_pct decimal(5,4) [note: 'Member\'s percentage cost share for a 90-day mail-order fill at this tier. Null when the mail tier uses a flat copay.']
  mail_copay_amount decimal(10,2) [note: 'Fixed dollar copay for a 90-day mail-order supply at this tier. Typically lower than retail to incentivize mail utilization. Null if mail uses coinsurance.']
  max_copay_amount decimal(10,2) [note: 'Maximum dollar cap on member cost share per fill at this tier when coinsurance applies. Protects members from excessive out-of-pocket on high-cost drugs.']
  maximizer_program_applies boolean [note: 'Indicates whether a copay maximizer program is active for this tier, extracting the full manufacturer copay card value without applying it to member OOP accumulators.']
  min_copay_amount decimal(10,2) [note: 'Minimum dollar floor on member cost share per fill at this tier when coinsurance applies. Ensures a minimum member contribution even for low-cost drugs.']
  oop_applies boolean [note: 'Indicates whether member cost share at this tier accumulates toward the plan\'s maximum out-of-pocket (MOOP) limit. Relevant for copay accumulator and maximizer program analysis.']
  pbm_tier_code varchar [note: 'The raw tier code as transmitted by the PBM in claims feeds or formulary files before normalization. Preserved for PBM audit reconciliation and cross-PBM benchmarking.']
  pbm_tier_name varchar [note: 'The raw tier label as transmitted by the PBM before normalization (e.g., \'Preferred Drug List Tier 2\'). Retained for audit traceability and PBM contract reconciliation.']
  plan_year varchar [note: 'The benefit plan year (e.g., 2024) to which this formulary tier definition applies. Enables year-over-year tier change analysis and PBM contract guarantee auditing.']
  preventive_tier boolean [note: 'Indicates this is a zero-cost-share preventive drug tier as required under ACA Section 2713 and IRS Notice 2019-45 for HSA-compatible plans.']
  prior_auth_required boolean [note: 'Indicates whether drugs on this tier require prior authorization (PA) before the plan will cover them. Drives PA workflow routing in the PillarRx analytics module.']
  quantity_limit_applies boolean [note: 'Indicates whether quantity limits (QL) are enforced at this tier, restricting the maximum dispensed quantity per fill or per period.']
  scd_end_date date [note: 'End date of this SCD Type-2 version row\'s validity window. Null for the current active row; populated when a new version supersedes this record.']
  scd_start_date date [note: 'Start date of this SCD Type-2 version row\'s validity window. Set when the record is first created or when a change creates a new version.']
  source_file_name varchar [note: 'Name of the PBM formulary extract file from which this tier record was loaded. Supports ETL traceability and PBM audit reconciliation.']
  specialty_tier boolean [note: 'Flags this tier as a specialty medication (SMN) tier, typically carrying the highest member cost share and subject to specialty pharmacy network restrictions.']
  step_therapy_required boolean [note: 'Indicates whether step therapy (ST) applies at this tier, requiring members to try a lower-cost drug before the plan covers the requested drug.']
  tier_code varchar [note: 'Short alphanumeric code identifying the tier as used in PBM data feeds and formulary files (e.g., T1, T2, T3, T4). Aligns with PBM-sourced formulary extract codes.']
  tier_description varchar [note: 'Free-text description of the tier\'s purpose, drug categories covered, and any special cost-share rules. Used in member-facing EOB communications and consulting deliverables.']
  tier_label varchar [note: 'Human-readable name for the tier as displayed to members and plan sponsors (e.g., Generic, Preferred Brand, Non-Preferred Brand, Specialty). [ENUM-REF-CANDIDATE: Generic|Preferred Generic|Non-Preferred Generic|Preferred Brand|Non-Preferred']
  tier_number varchar [note: 'Numeric rank of the tier within the formulary (e.g., 1=Generic, 2=Preferred Brand, 3=Non-Preferred Brand, 4=Specialty). Lower numbers typically indicate lower member cost share.']
  tier_status varchar [note: 'Current lifecycle state of the formulary tier record. Active tiers are in use for adjudication; retired tiers are preserved for historical audit.']
  tier_type varchar [note: 'Broad classification of the tier\'s drug category (e.g., standard, specialty, preventive, select_care). Drives benefit design rules and member cost-share logic.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this formulary tier record. Used for change detection in incremental ETL loads and audit logging.']

  Note: 'Defines an individual cost-sharing tier within a formulary and is the AUTHORITATIVE SSOT for member out-of-pocket obligation per tier. Captures the tier number, tier label (Generic, Preferred Brand, Non-Preferred Brand, Specialty), copay amount'
}

Table division.formulary_drug_placement {
  formulary_drug_placement_id varchar [pk, note: 'Unique surrogate identifier for a formulary drug placement record associating a drug (NDC or GPI) with a formulary tier during a defined effective period.']
  division_formulary_id varchar [note: 'FK to division.formulary.formulary_id — Placement is scoped to a formulary; needed for formulary change tracking over time.']
  division_formulary_tier_id varchar [note: 'Reference to the formulary tier definition record that specifies cost-sharing rules for this drug placement.']
  formulary_tier_id varchar [note: 'FK to division.formulary_tier.formulary_tier_id — Placement assigns an NDC/GPI to a specific tier; placement must reference the tier it lands on.']
  ndc_id varchar [note: 'Reference to the 11-digit National Drug Code record for the specific drug product placed on this formulary tier. Null when placement is at GPI class level.']
  primary_division_formulary_id varchar [note: 'Reference to the formulary (covered drug list) on which this drug placement is defined. Links to the parent formulary record.']
  prior_auth_rule_id varchar [note: 'Foreign key linking to division.prior_auth_rule. Business justification: Links a drug placement to the PA rule that applies when pa_required is true. When a drug on a formulary requires prior authorization, this FK identifies the specific rule.']
  source_pbm_formulary_division_formulary_id varchar [note: 'The PBM\'s native formulary identifier for this drug placement as received in the PBM claims or formulary feed. Supports traceability back to the originating PBM source system.']
  age_restriction_max varchar [note: 'Maximum member age (in years) allowed for coverage under this formulary drug placement. Null indicates no maximum age restriction applies.']
  age_restriction_min varchar [note: 'Minimum member age (in years) required for coverage under this formulary drug placement. Null indicates no minimum age restriction applies.']
  coinsurance_pct decimal(5,4) [note: 'Percentage of drug cost the member pays as coinsurance for this formulary tier placement (e.g., 0.20 = 20%). Null when cost-sharing is fixed copay-based.']
  copay_amount decimal(10,2) [note: 'Fixed dollar copay amount the member is responsible for when filling a drug under this formulary tier placement. Null when cost-sharing is coinsurance-based.']
  coverage_type varchar [note: 'Indicates the dispensing channel(s) for which this formulary drug placement applies: retail pharmacy, mail-order, specialty pharmacy, or both retail and mail.']
  created_timestamp timestamp [note: 'Timestamp when this formulary drug placement record was first created in the data platform. Used for audit trail and SCD history management.']
  days_supply_limit varchar [note: 'Maximum days supply allowed per fill for this formulary drug placement (e.g., 30 days at retail, 90 days at mail order). Enforced at point-of-sale adjudication.']
  drug_name varchar [note: 'Brand or generic drug name associated with this formulary placement. Denormalized for reporting convenience; authoritative name resides in the NDC/drug reference dimension.']
  effective_date date [note: 'Date on which this formulary drug placement becomes effective and governs member cost-sharing for claims adjudicated on or after this date.']
  excluded_indicator boolean [note: 'Indicates whether this drug is explicitly excluded from formulary coverage. Excluded drugs are not covered under the plan and require non-formulary exception processing.']
  formulary_alternative_ndc varchar [note: 'NDC of the preferred formulary alternative drug recommended when this placement carries restrictions (PA, ST, QL). Supports member and prescriber messaging for step therapy.']
  formulary_status_code varchar [note: 'NCPDP-standard formulary status code indicating coverage disposition: 1=On Formulary, 2=Non-Formulary, 3=Formulary with Restrictions, 4=Not Covered, 5=Covered, 6=Prior Auth. [ENUM-REF-CANDIDATE: promote to reference product if values expand]']
  gender_restriction varchar [note: 'Gender restriction for this formulary drug placement: M=Male only, F=Female only, U=No restriction. Applies to gender-specific drugs (e.g., contraceptives, hormone therapy).']
  generic_indicator varchar [note: 'Indicates whether the drug placed on this formulary tier is a brand, generic, or biosimilar product. Drives Generic Dispensing Rate (GDR) analytics and rebate tracking.']
  gpi varchar [note: '14-digit Medi-Span Generic Product Identifier representing the drug class or therapeutic group when formulary placement is defined at the GPI level rather than specific NDC.']
  is_current boolean [note: 'Type-2 SCD flag indicating whether this is the current active version of the formulary drug placement record. True for the most recent version; False for historical versions.']
  limited_distribution_indicator boolean [note: 'Indicates whether this drug is a Limited Distribution Drug (LDD), available only through select specialty pharmacies designated by the manufacturer.']
  mail_coinsurance_pct decimal(5,4) [note: 'Percentage of drug cost the member pays as coinsurance for mail-order dispensing under this formulary tier placement. Null when mail cost-sharing is fixed copay-based.']
  mail_copay_amount decimal(10,2) [note: 'Fixed dollar copay amount for mail-order dispensing of this drug under this formulary tier placement. Often lower than retail copay to incentivize mail utilization.']
  ndc varchar [note: '11-digit FDA-assigned National Drug Code identifying the specific drug product, labeler, and package size placed on this formulary tier. Null when placement is GPI-level.']
  otc_indicator boolean [note: 'Indicates whether this formulary drug placement covers an over-the-counter (OTC) product. OTC coverage is plan-specific and may carry different cost-sharing rules.']
  pa_required boolean [note: 'Indicates whether a Prior Authorization (PA) is required before this drug will be covered under the formulary placement. True triggers PA workflow at point of dispensing.']
  placement_level varchar [note: 'Indicates whether this formulary placement is defined at the specific NDC level, GPI drug class level, or broader GPI therapeutic class level.']
  placement_status varchar [note: 'Current lifecycle status of this formulary drug placement record. Active placements govern current benefit adjudication; inactive or terminated records are retained for historical audit.']
  preferred_indicator boolean [note: 'Indicates whether this drug is designated as a preferred product within its tier, typically associated with lower member cost-sharing and higher rebate eligibility.']
  quantity_limit_amount decimal(10,3) [note: 'Maximum quantity (units, tablets, mL, etc.) allowed per fill or per defined period when a Quantity Limit applies to this formulary placement. Null when QL is not required.']
  quantity_limit_days varchar [note: 'Number of days supply over which the quantity limit amount applies for this formulary drug placement (e.g., 30 days, 90 days). Null when QL is not required.']
  quantity_limit_required boolean [note: 'Indicates whether a Quantity Limit (QL) restriction applies to this formulary drug placement, capping the dispensable quantity per fill or per defined period.']
  rebate_eligible_indicator boolean [note: 'Indicates whether claims filled under this formulary drug placement are eligible for manufacturer rebates. Supports rebate contract reconciliation and DIR fee analysis.']
  scd_version varchar [note: 'Incrementing version number for Type-2 Slowly Changing Dimension (SCD) history tracking of this formulary drug placement record. Version 1 is the original; higher values are subsequent changes.']
  specialty_drug_indicator boolean [note: 'Indicates whether this formulary drug placement is classified as a specialty medication (SMN), typically requiring specialty pharmacy dispensing and enhanced clinical management.']
  step_therapy_required boolean [note: 'Indicates whether Step Therapy (ST) applies to this formulary placement, requiring the member to try a preferred drug before coverage of this drug is approved.']
  termination_date date [note: 'Date on which this formulary drug placement expires or is removed. Null indicates an open-ended placement with no defined end. Supports Type-2 SCD history tracking.']
  therapeutic_class_code varchar [note: 'Drug therapeutic class code from Medi-Span or First DataBank (FDB) classification system associated with this formulary placement. Supports formulary analysis by drug class.']
  therapeutic_class_name varchar [note: 'Human-readable therapeutic class name corresponding to the therapeutic class code for this formulary drug placement. Used in formulary reporting and consulting deliverables.']
  tier_name varchar [note: 'Human-readable label for the formulary tier assigned to this drug (e.g., \'Generic\', \'Preferred Brand\', \'Non-Preferred Brand\', \'Specialty\'). Supports reporting and member communications.']
  tier_number varchar [note: 'Numeric tier level assigned to this drug on the formulary (e.g., 1=Generic, 2=Preferred Brand, 3=Non-Preferred Brand, 4=Specialty). Drives member cost-sharing.']
  updated_timestamp timestamp [note: 'Timestamp when this formulary drug placement record was last modified in the data platform. Tracks changes for SCD Type-2 history and audit compliance.']

  Note: 'Transactional/association record capturing the placement of a specific NDC (or GPI drug class) on a formulary tier during a defined effective period. Stores the NDC or GPI, the assigned tier number, prior authorization (PA) requirement flag, step therapy'
}

Table division.prior_auth_rule {
  prior_auth_rule_id varchar [pk, note: 'Unique surrogate identifier for the prior authorization or step therapy rule record in the Pillarrx lakehouse.']
  client_benefit_group_id varchar [note: 'Reference to the benefit group under which this PA or ST rule is enforced, scoping the rule to a specific employer plan benefit design.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that administers and enforces this prior authorization rule.']
  division_benefit_group_id varchar [note: 'FK to division.division_benefit_group.division_benefit_group_id — PA/ST rules are applied within a benefit group or formulary; benefit-group scoping is needed for UM compliance analysis.']
  division_formulary_id varchar [note: 'Reference to the formulary on which this rule is defined. A rule may be formulary-scoped rather than benefit-group-scoped when the PBM manages rules at the formulary level.']
  prior_version_rule_prior_auth_rule_id varchar [note: 'Self-referencing identifier pointing to the previous version of this rule record. Enables Type-2 slowly changing dimension history traversal for audit and trend analysis.']
  age_max_years varchar [note: 'Maximum member age in years for this rule to apply. Used for pediatric or geriatric-specific PA criteria. Null if no upper age restriction.']
  age_min_years varchar [note: 'Minimum member age in years required for this rule to apply or for the drug to be approved without PA. Null if no age restriction.']
  appeals_allowed_indicator boolean [note: 'Indicates whether the member or prescriber may file a formal appeal if the PA request is denied under this rule. Required for ERISA plan compliance.']
  approval_duration_days varchar [note: 'Number of days a PA approval remains valid once granted before re-authorization is required. Drives PA renewal workflow in the Prior Authorization Analytics module.']
  clinical_criteria_summary varchar [note: 'Plain-language summary of the clinical criteria a member must meet to satisfy this PA or ST rule (e.g., \'Diagnosis of moderate-to-severe RA; trial of 2 DMARDs required\').']
  created_timestamp timestamp [note: 'Timestamp when this prior authorization rule record was first created in the Pillarrx lakehouse. Used for audit trail and data lineage.']
  diagnosis_code_required varchar [note: 'ICD-10-CM diagnosis code that must be present on the PA request for approval. Comma-separated list if multiple qualifying diagnoses exist.']
  effective_date date [note: 'Date on which this prior authorization or utilization management rule becomes enforceable for claims adjudication.']
  formulary_tier varchar [note: 'Formulary cost-sharing tier to which the target drug belongs under this rule. Tier placement affects member cost share and PA applicability.']
  gender_restriction varchar [note: 'Gender restriction for this rule: M=Male only, F=Female only, U=No restriction (unrestricted). Applies to gender-specific clinical criteria.']
  limited_distribution_indicator boolean [note: 'Indicates whether the target drug is a limited distribution drug (LDD) available only through select specialty pharmacies, adding an additional access control layer.']
  notes varchar [note: 'Free-text field for consultant or analyst annotations regarding this rule, such as PBM-specific nuances, client exceptions, or audit findings.']
  override_allowed_indicator boolean [note: 'Indicates whether a pharmacist or prescriber override is permitted at point of sale without a formal PA approval (e.g., emergency supply override).']
  pbm_rule_reference_code varchar [note: 'Native identifier assigned by the PBM system to this rule in their adjudication platform. Used for cross-referencing during PBM audits and guarantee reconciliation.']
  quantity_limit_days varchar [note: 'Number of days in the measurement period for the quantity limit (e.g., 30 days, 90 days). Defines the rolling window for QL enforcement.']
  quantity_limit_unit varchar [note: 'Unit of measure for the quantity limit value (e.g., tablets, mL, units). Required when quantity_limit_value is populated. [ENUM-REF-CANDIDATE: tablets|capsules|mL|units|patches|vials|grams|mcg — promote to reference product]']
  quantity_limit_value decimal(10,3) [note: 'Maximum dispensable quantity allowed per fill or per period under a quantity limit rule (e.g., 30 tablets per 30 days). Null for non-QL rule types.']
  renewal_required_indicator boolean [note: 'Indicates whether this PA rule requires periodic renewal after the initial approval duration expires, triggering re-evaluation of clinical criteria.']
  rule_code varchar [note: 'Externally-known alphanumeric code assigned by the PBM or plan to uniquely identify this PA/ST/QL rule within their system. Used for audit and reconciliation.']
  rule_name varchar [note: 'Human-readable name describing the prior authorization or utilization management rule (e.g., \'Humira PA Criteria\', \'Specialty Step Therapy - TNF Inhibitors\').']
  rule_status varchar [note: 'Current lifecycle state of the rule: active (enforced), inactive (suspended), pending (approved but not yet effective), retired (superseded or removed).']
  rule_type varchar [note: 'Classifies the utilization management rule: PA=Prior Authorization, ST=Step Therapy, QL=Quantity Limit, NF=Non-Formulary, SP=Specialty Designation. [ENUM-REF-CANDIDATE: PA|ST|QL|NF|SP|DAW — promote to reference product if additional types emerge]']
  rule_version varchar [note: 'Version number of this rule definition (e.g., \'1.0\', \'2.3\'). Incremented when clinical criteria or parameters are updated. Supports Type-2 SCD history tracking.']
  specialty_drug_indicator boolean [note: 'Indicates whether this rule governs a specialty medication (SMN), which typically requires specialty pharmacy dispensing and enhanced clinical management.']
  step_sequence_number varchar [note: 'Ordinal position of this drug in the step therapy ladder (1=first-line, 2=second-line, etc.). Null for PA and QL rules that are not step-based.']
  step_therapy_predecessor_name varchar [note: 'Brand or generic name of the step therapy predecessor drug. Denormalized for readability in PA analytics and consulting deliverables.']
  step_therapy_predecessor_ndc varchar [note: '11-digit NDC of the first-line drug that must be tried and failed before the target drug is approved under a step therapy rule. Null for non-ST rule types.']
  target_drug_name varchar [note: 'Brand or generic drug name associated with the target NDC or GPI. Denormalized for readability in reporting and consulting deliverables.']
  target_gpi varchar [note: '14-digit Medi-Span Generic Product Identifier representing the drug class or therapeutic group to which this rule applies when scoped above the NDC level.']
  target_ndc varchar [note: '11-digit FDA National Drug Code identifying the specific drug product to which this rule applies. Mutually exclusive with target_gpi when rule is NDC-level.']
  termination_date date [note: 'Date on which this rule ceases to be enforceable. Null indicates the rule is open-ended with no scheduled end date.']
  therapeutic_class_code varchar [note: 'Drug therapeutic class code (e.g., Medi-Span or FDB therapeutic class) identifying the clinical category of drugs governed by this rule.']
  therapeutic_class_name varchar [note: 'Human-readable name of the therapeutic drug class (e.g., \'TNF Inhibitors\', \'SGLT2 Inhibitors\') for reporting and consulting analysis.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this prior authorization rule record. Used for change detection and incremental ETL processing.']

  Note: 'Master record defining a prior authorization (PA) or step therapy (ST) rule applied within a benefit group or formulary. Captures the rule type (PA, ST, QL), the target NDC or GPI drug class, the clinical criteria summary, the step therapy predecessor'
}

Table division.prior_auth_request {
  prior_auth_request_id varchar [pk, note: 'Unique surrogate identifier for the prior authorization request record in the PillarRx lakehouse. Primary key for this entity.']
  benefit_plan_id varchar [note: 'Identifier of the specific benefit plan or benefit group under which this PA request is evaluated. Determines formulary tier and cost-sharing rules.']
  company_pbm_id varchar [note: 'Identifier of the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that adjudicates this PA request on behalf of the plan.']
  division_id varchar [note: 'Identifier of the PillarRx division responsible for managing this client engagement. Supports multi-tenant data scoping.']
  employer_id varchar [note: 'Identifier of the employer client (plan sponsor) under whose benefit plan this PA request was submitted. Links to the Company > Division > Client hierarchy.']
  linked_rx_claim_id varchar [note: 'Identifier of the pharmacy claim (rx_claim) that was adjudicated using this PA authorization. Enables PA-to-claim linkage for audit and utilization analysis.']
  ndc_id varchar [note: 'Surrogate key referencing the 11-digit NDC of the drug for which prior authorization is being requested. Links to the drug dimension.']
  prior_auth_rule_id varchar [note: 'Foreign key linking to division.prior_auth_rule. Business justification: Links a PA request to the specific PA rule that triggered it. Prior auth requests are evaluated against PA rules defined in the benefit group/formulary.']
  appeal_date date [note: 'Date on which the appeal of a denied PA was formally submitted. Null if no appeal has been filed.']
  appeal_indicator boolean [note: 'Indicates whether a formal appeal has been filed against a PA denial decision. Triggers appeal tracking workflow in the Prior Authorization Analytics module.']
  appeal_outcome varchar [note: 'Result of the PA appeal review. Overturned appeals result in authorization; upheld appeals confirm the original denial.']
  clinical_indication varchar [note: 'Diagnosis or clinical rationale submitted by the prescriber to support the PA request. Contains PHI. Used for clinical appropriateness review.']
  created_timestamp timestamp [note: 'Timestamp when this PA request record was first created in the PillarRx lakehouse. Supports audit trail and data lineage.']
  days_supply_requested varchar [note: 'Number of days supply of the drug requested in the PA submission. Used to evaluate quantity limit compliance and dispensing channel appropriateness.']
  decision_date date [note: 'Calendar date the PBM or plan issued a final decision (approval, denial, or cancellation) on the PA request.']
  decision_timestamp timestamp [note: 'Precise date and time the PA decision was rendered. Used to compute exact turnaround hours for SLA and regulatory compliance reporting.']
  denial_reason_code varchar [note: 'Standardized code issued by the PBM indicating the reason for PA denial (e.g., not medically necessary, step therapy required, non-formulary). Null if approved.']
  denial_reason_description varchar [note: 'Free-text or standardized description of the denial reason provided by the PBM. Supports member communication and consulting audit analysis.']
  drug_name varchar [note: 'Brand or generic name of the drug for which PA is requested. Sourced from Medi-Span or FDB. Supports human-readable reporting without dimension join.']
  effective_date date [note: 'Date from which an approved PA authorization is valid for claim adjudication. Claims filled before this date will not satisfy the PA requirement.']
  expiration_date date [note: 'Date on which the approved PA authorization expires. Claims filled after this date require a new PA submission.']
  formulary_tier varchar [note: 'Formulary tier of the requested drug under the applicable benefit plan at the time of PA submission. Influences cost-sharing and PA criteria.']
  icd10_diagnosis_code varchar [note: 'ICD-10-CM diagnosis code submitted with the PA request to establish medical necessity. PHI. Supports clinical analytics and denial pattern analysis.']
  is_specialty_drug boolean [note: 'Indicates whether the requested drug is classified as a specialty medication (SMN). Specialty drugs typically have higher PA rates and require additional clinical review.']
  notes varchar [note: 'Free-text notes or supplemental clinical documentation attached to the PA request by the prescriber, plan, or PillarRx consulting team.']
  pa_number varchar [note: 'Externally assigned PA reference number issued by the PBM or plan upon submission. Used for claim adjudication linkage and audit trail.']
  pa_status varchar [note: 'Current lifecycle status of the PA request. Drives workflow routing, member notification, and consulting audit reporting.']
  pa_type varchar [note: 'Classification of the PA request by processing urgency or timing. Expedited PAs have regulatory turnaround requirements under CMS and state law.']
  pbm_name varchar [note: 'Name of the PBM that processed this PA request (e.g., CVS Caremark, Optum Rx, Express Scripts). Denormalized for direct reporting without dimension join.']
  pbm_pa_reference varchar [note: 'PBM-assigned internal reference number for this PA request as received in the PBM claims feed or PA data extract. Supports cross-system reconciliation.']
  prescriber_npi varchar [note: '10-digit NPI of the prescribing provider who initiated the PA request. Sourced from NPPES. Used for prescriber-level PA analytics.']
  quantity_limit_unit varchar [note: 'Unit of measure for the quantity limit value (e.g., tablets, ml, days supply). Required to interpret the quantity_limit_value correctly.']
  quantity_limit_value decimal(10,3) [note: 'Maximum quantity or days supply authorized per fill or period under the PA approval. Null if no quantity limit applies to this PA.']
  source_file_name varchar [note: 'Name of the source data file from which this PA record was loaded. Supports data lineage, audit trail, and ETL troubleshooting.']
  step_therapy_required boolean [note: 'Indicates whether the PA denial or criteria requires the member to try a preferred (step) drug before the requested drug will be authorized.']
  submission_date date [note: 'Calendar date the PA request was formally submitted to the PBM or plan. Used to calculate turnaround time and regulatory compliance.']
  submission_timestamp timestamp [note: 'Precise date and time the PA request was submitted. Supports SLA measurement and expedited PA regulatory turnaround tracking.']
  turnaround_hours decimal(8,2) [note: 'Elapsed hours from PA submission to decision. Stored as a business-captured field from the PBM feed; not derived in this layer. Used for SLA and regulatory compliance.']
  updated_timestamp timestamp [note: 'Timestamp when this PA request record was last modified in the PillarRx lakehouse. Tracks status changes, appeal updates, and data corrections.']

  Note: 'Transactional record capturing an individual prior authorization request submitted for a member and drug under a specific benefit group. Stores the requesting prescriber NPI, the target NDC, the clinical indication, the submission date, the PBM decision'
}

Table division.rebate_contract {
  rebate_contract_id varchar [pk, note: 'Unique surrogate identifier for the manufacturer rebate contract record in the PillarRx data lakehouse.']
  division_pbm_contract_id varchar [note: 'FK to division.division_pbm_contract.division_pbm_contract_id — Rebate contracts are associated with a PBM contract per the description; needed to tie rebate terms to pricing terms.']
  employer_id varchar [note: 'Reference to the employer client (plan sponsor) for whom this rebate contract applies within the Company > Division > Client hierarchy.']
  manufacturer_id varchar [note: 'Reference to the pharmaceutical manufacturer party that is the counterparty to this rebate contract.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract under which this manufacturer rebate agreement is negotiated and administered.']
  amendment_number varchar [note: 'Sequential amendment number for this rebate contract. Zero (0) indicates the original executed contract; positive integers indicate subsequent amendments.']
  audit_flag boolean [note: 'Indicates whether this rebate contract has been flagged for PBM audit review due to discrepancies between guaranteed rebate terms and actual rebate payments received.']
  base_rebate_per_unit decimal(18,6) [note: 'Guaranteed flat rebate dollar amount per dispensed unit (e.g., per tablet, per milliliter) under the base rebate tier of this contract. Used in rebate accrual and PBM audit calculations.']
  base_rebate_percent_awp decimal(7,4) [note: 'Base rebate expressed as a percentage of the drug\'s Average Wholesale Price (AWP). Common in brand drug rebate contracts. E.g., 15.00 = 15% of AWP.']
  base_rebate_pmpm decimal(18,6) [note: 'Guaranteed flat rebate expressed as a Per Member Per Month (PMPM) dollar amount. Used when the contract is structured on a population basis rather than per-unit dispensing.']
  contract_name varchar [note: 'Human-readable descriptive name for the rebate contract, typically referencing the manufacturer brand or therapeutic class covered (e.g., \'AstraZeneca Oncology Base Rebate 2024\').']
  contract_number varchar [note: 'Externally-known alphanumeric identifier assigned by the PBM or manufacturer to uniquely reference this rebate contract in source systems and correspondence.']
  contract_status varchar [note: 'Current lifecycle state of the rebate contract. Active = in force; Pending = awaiting execution; Expired = past end date; Terminated = cancelled early; Suspended = temporarily paused; Draft = not yet executed.']
  contract_version varchar [note: 'Version identifier for this rebate contract record, supporting amendment tracking. Incremented when contract terms are renegotiated or amended (e.g., \'1.0\', \'2.0\', \'Amendment 3\').']
  coverage_type varchar [note: 'Indicates whether the rebate applies to a specific brand drug, a generic, a specialty drug, an entire therapeutic class, or a single National Drug Code (NDC).']
  created_timestamp timestamp [note: 'Timestamp when this rebate contract record was first created in the PillarRx data lakehouse. Used for data lineage, audit trail, and Silver layer record management.']
  dir_applicable_indicator boolean [note: 'Indicates whether rebates under this contract are subject to CMS Direct and Indirect Remuneration (DIR) reporting requirements, applicable for Medicare Part D plans.']
  drug_brand_name varchar [note: 'Brand name of the drug or drug family covered by this rebate contract (e.g., \'Humira\', \'Eliquis\'). Null if the contract covers a therapeutic class rather than a specific brand.']
  effective_date date [note: 'Date on which the rebate contract becomes legally binding and rebate accruals begin. Aligns with the plan year or negotiated contract start date.']
  execution_date date [note: 'Date the rebate contract was formally signed and executed by all parties. May differ from the effective date when contracts are backdated or signed in advance.']
  expiration_date date [note: 'Date on which the rebate contract expires and rebate accruals cease. Null for open-ended contracts. Used in PBM audit and guarantee reconciliation.']
  formulary_tier varchar [note: 'Formulary tier placement required or associated with this rebate contract. Rebate amounts are often contingent on the drug being placed at a specific formulary tier by the plan.']
  guaranteed_rebate_per_unit decimal(18,6) [note: 'Minimum guaranteed rebate per dispensed unit committed by the PBM under the Guaranteed Effective Rate (GER) provision of the contract, used in PBM audit and guarantee reconciliation.']
  limited_distribution_indicator boolean [note: 'Indicates whether the drug covered by this rebate contract is a Limited Distribution Drug (LDD), available only through select specialty pharmacies, which may affect rebate eligibility.']
  market_share_target_percent decimal(7,4) [note: 'Required market share percentage of the covered drug within its therapeutic class that must be achieved to qualify for market share rebate tiers. E.g., 40.00 = 40% market share.']
  minimum_claim_volume varchar [note: 'Minimum number of paid pharmacy claims for the covered drug required within the measurement period before any rebate is earned under this contract.']
  notes varchar [note: 'Free-text field for consultant or analyst annotations regarding special contract terms, negotiation history, audit findings, or other contextual information not captured in structured fields.']
  pass_through_indicator boolean [note: 'Indicates whether this rebate contract operates under a pass-through (transparent) PBM pricing model where 100% of manufacturer rebates are passed to the plan sponsor.']
  pbm_contract_fk varchar [note: 'FK to division.pbm_contract.pbm_contract_id — rebate_contract is \'associated with a PBM contract\'; required to roll rebate terms up to the governing PBM contract.']
  pbm_name varchar [note: 'Name of the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that administers this rebate contract on behalf of the plan sponsor.']
  performance_rebate_per_unit decimal(18,6) [note: 'Incremental rebate per dispensed unit earned when performance thresholds (utilization, market share, or quality targets) are achieved under this contract.']
  performance_threshold_unit varchar [note: 'Unit of measure for the performance threshold value (e.g., percent for market share targets, claim_count for volume targets, units_dispensed for dispensing volume).']
  performance_threshold_value decimal(18,6) [note: 'Numeric threshold that must be met to trigger performance rebate payment (e.g., market share percentage, minimum claim volume, Generic Dispensing Rate (GDR) target).']
  rebate_basis varchar [note: 'The basis on which the rebate amount is calculated: per dispensed unit, Per Member Per Month (PMPM), percentage of Average Wholesale Price (AWP), percentage of Wholesale Acquisition Cost (WAC), or flat fee.']
  rebate_lag_days varchar [note: 'Number of calendar days after the close of the rebate measurement period before the rebate payment is due from the manufacturer or PBM. Typically 90-180 days for quarterly contracts.']
  rebate_payment_frequency varchar [note: 'Frequency at which rebate payments are remitted by the manufacturer or PBM to the plan sponsor (e.g., quarterly is most common in PBM rebate contracts).']
  rebate_type varchar [note: 'Classification of the rebate structure. Base = guaranteed flat rebate; Performance = tied to utilization targets; Market Share = tied to drug market share; Formulary Placement = tied to tier position.']
  specialty_drug_indicator boolean [note: 'Indicates whether this rebate contract covers a specialty medication (SMN), which typically has higher rebate values and more complex performance tiers than standard brand drugs.']
  termination_date date [note: 'Date the rebate contract was early-terminated prior to its scheduled expiration date. Null if the contract ran to its natural expiration.']
  therapeutic_class_code varchar [note: 'Medi-Span or First DataBank (FDB) therapeutic class code identifying the drug class covered by this rebate contract when the contract applies at the class level rather than a single brand.']
  therapeutic_class_name varchar [note: 'Human-readable name of the therapeutic drug class covered by this rebate contract (e.g., \'TNF Inhibitors\', \'SGLT2 Inhibitors\'), sourced from Medi-Span or FDB.']
  updated_timestamp timestamp [note: 'Timestamp when this rebate contract record was last modified in the PillarRx data lakehouse. Supports change tracking and Silver layer incremental processing.']

  Note: 'Master record for a manufacturer rebate contract associated with a PBM contract and formulary. Captures the manufacturer name, drug brand or therapeutic class covered, rebate type (base, performance, market share), guaranteed rebate per unit or PMPM'
}

Table division.rebate_payment {
  rebate_payment_id varchar [pk, note: 'Unique surrogate identifier for each rebate payment record in the Pillarrx data lakehouse. Primary key for the rebate_payment entity.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) that remitted or reported this rebate payment to the plan.']
  division_id varchar [note: 'Reference to the Division within the Company > Division > Client hierarchy on whose behalf this rebate payment was received and tracked.']
  employer_id varchar [note: 'Reference to the employer client (plan sponsor) whose pharmacy benefit generated the rebate. Scopes the payment within the multi-tenant hierarchy.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract under which this rebate was earned and remitted. Links payment to specific guarantee terms for audit and benchmarking.']
  primary_rebate_contract_id varchar [note: 'Foreign key linking to division.rebate_contract. Business justification: Links a rebate payment to the specific rebate contract under which it was made. Rebate payments are made according to rebate contracts negotiated with manufacturers.']
  rebate_contract_id varchar [note: 'FK to division.rebate_contract.rebate_contract_id — rebate_payment reconciles \'against the contracted rebate guarantee\' in rebate_contract — mandatory transaction->master FK for rebate reconciliation.']
  ach_trace_number varchar [note: 'ACH transaction trace number assigned by the originating bank when payment_method is ACH. Enables bank statement reconciliation and dispute resolution.']
  admin_fee_withheld decimal(18,2) [note: 'Dollar amount withheld by the PBM as an administrative or management fee before remitting the net rebate to the plan. Relevant for pass-through vs. spread pricing audit.']
  check_number varchar [note: 'Check number when payment_method is check. Used for bank reconciliation and audit. Null for ACH, wire, or credit memo payments.']
  claim_count varchar [note: 'Number of pharmacy claims included in the rebate calculation for this payment period. Used to compute per-claim rebate rates and validate against PBM reporting.']
  cost_center_code varchar [note: 'Financial cost center code associated with this rebate payment for internal allocation and Brown & Brown parent company financial reporting.']
  created_timestamp timestamp [note: 'Timestamp when this rebate payment record was first created in the Pillarrx data lakehouse. Audit trail for data governance and SOX compliance.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this record. Defaults to USD for domestic PBM rebate payments.']
  dispute_amount decimal(18,2) [note: 'Dollar amount under dispute when payment_status is disputed. Represents the shortfall between guaranteed_amount and payment_amount being formally contested.']
  dispute_reason varchar [note: 'Free-text or coded reason for disputing this rebate payment when payment_status is disputed. Documents the basis for the shortfall claim against the PBM.']
  expected_payment_date date [note: 'Contractually expected date by which the PBM or manufacturer was obligated to remit the rebate. Used to identify late payments and trigger dispute workflows.']
  gl_account_code varchar [note: 'General Ledger account code in NetSuite / Brown & Brown Finance to which this rebate payment is posted. Supports financial reporting and SOX compliance.']
  guaranteed_amount decimal(18,2) [note: 'Contractually guaranteed rebate amount for the period per the PBM contract (Guaranteed Effective Rate or per-claim guarantee). Baseline for variance and audit analysis.']
  is_pass_through boolean [note: 'Indicates whether the PBM contract is pass-through (True) meaning 100% of manufacturer rebates are remitted to the plan, versus spread/retained model (False).']
  is_reconciled boolean [note: 'Indicates whether this rebate payment has been fully reconciled against the PBM contract guarantee and claim-level detail. True when reconciliation is complete.']
  net_payment_amount decimal(18,2) [note: 'Net dollar amount received by the plan after deducting admin_fee_withheld from payment_amount. Represents actual plan benefit from the rebate payment.']
  notes varchar [note: 'Free-text notes or comments entered by a Pillarrx analyst regarding this rebate payment. Used to document reconciliation findings, dispute context, or client communication.']
  payment_amount decimal(18,2) [note: 'Gross dollar amount of the rebate payment as remitted by the PBM or manufacturer. Denominated in USD. Core financial fact for reconciliation and client reporting.']
  payment_date date [note: 'The actual date the rebate payment was received (cash receipt date) or the date the PBM remitted the payment per the remittance advice.']
  payment_method varchar [note: 'Instrument or mechanism by which the rebate was remitted: ACH electronic transfer, paper check, wire transfer, credit memo applied against invoices, offset against fees, or other.']
  payment_number varchar [note: 'Externally assigned payment reference number provided by the PBM or manufacturer on the remittance advice. Used for reconciliation and audit tracing.']
  payment_status varchar [note: 'Current lifecycle state of the rebate payment. Drives reconciliation workflow: pending (expected), received (cash in), reconciled (matched to guarantee), disputed, voided, or adjusted.']
  payment_type varchar [note: 'Classifies the nature of the payment: PBM-remitted rebate, direct manufacturer rebate, Direct and Indirect Remuneration (DIR) fee, admin fee, performance bonus, or other. [ENUM-REF-CANDIDATE: promote to reference product if values expand]']
  rebate_as_pct_of_spend decimal(8,4) [note: 'Rebate payment expressed as a percentage of total_drug_spend for the period. Key PBM performance metric used in benchmarking and guarantee audit reporting.']
  rebate_per_claim decimal(10,4) [note: 'Contractual or actual rebate amount per eligible claim for this payment period. Used in PBM guarantee audit to compare against contracted per-claim rebate rates.']
  rebate_period_end_date date [note: 'Last date of the rebate performance or utilization period to which this payment applies. Paired with rebate_period_start_date to define the measurement window.']
  rebate_period_start_date date [note: 'First date of the rebate performance or utilization period to which this payment applies. Typically a calendar quarter or contract year start.']
  reconciliation_date date [note: 'Date on which the rebate payment was reconciled against the PBM contract guarantee and claim detail. Populated when is_reconciled is True.']
  remittance_reference varchar [note: 'Reference number or identifier from the PBM or manufacturer remittance advice document accompanying the payment. Supports cash application and audit trail.']
  source_file_name varchar [note: 'Name of the PBM remittance file or data feed from which this rebate payment record was ingested. Supports data lineage and ETL audit tracing.']
  total_drug_spend decimal(18,2) [note: 'Total plan drug spend (ingredient cost basis) for the rebate period used as the denominator in rebate-as-percent-of-spend calculations and PBM performance benchmarking.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this rebate payment record. Tracks reconciliation status changes, dispute updates, and adjustment postings.']
  variance_amount decimal(18,2) [note: 'Difference between payment_amount and guaranteed_amount (payment_amount minus guaranteed_amount). Positive indicates overpayment; negative indicates shortfall requiring dispute or recovery.']

  Note: 'Transactional record capturing an actual rebate payment received from a PBM or manufacturer on behalf of a Division or Client for a specific rebate period.'
}

Table division.pbm_feed {
  pbm_feed_id varchar [pk, note: 'Unique surrogate identifier for the division-PBM feed configuration record. Primary key for this master agreement entity governing how PillarRx receives claim extracts from a PBM on behalf of a division.']
  company_pbm_id varchar [note: 'Reference to the PBM entity (CVS Caremark, Optum Rx, Express Scripts, Navitus, EmpiRx Health, BCBS Michigan, Rightway, Prime Therapeutics, ServeYou, Carelon) that is the source of this claims data feed.']
  division_id varchar [note: 'Reference to the division within the Company > Division > Client hierarchy that this PBM feed serves. A division may have multiple PBM feeds across different PBMs.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract record governing the terms under which this data feed is provided. Links the feed to the broader PBM service agreement for audit and reconciliation purposes.']
  baa_effective_date date [note: 'Date on which the HIPAA Business Associate Agreement with the PBM became effective for this feed. Used for compliance auditing and to ensure PHI exchange is covered by a valid BAA.']
  baa_on_file boolean [note: 'Indicates whether a signed HIPAA Business Associate Agreement (BAA) is on file with this PBM for this feed. A BAA is legally required before PHI can be exchanged. Feeds without a BAA must not be activated.']
  claim_types_included varchar [note: 'Pipe-delimited list of claim transaction types included in this feed (e.g., \'fill|reversal|adjustment\'). Defines the scope of claim data expected and drives validation rules in the ingestion pipeline.']
  created_timestamp timestamp [note: 'Timestamp when this PBM feed configuration record was first created in the system. Supports audit trail and feed lifecycle tracking per SOC 2 change management controls.']
  delivery_frequency varchar [note: 'How often the PBM delivers claim extract files for this feed. Daily feeds support near-real-time analytics; monthly feeds are common for smaller PBMs or historical loads.']
  delivery_method varchar [note: 'Technical mechanism by which the PBM delivers claim extract files to PillarRx. SFTP is most common; API-based and cloud storage (S3) delivery are increasingly used by modern PBMs.']
  dos_end_date date [note: 'Latest date of service (DOS) for claims expected in this feed. Null for ongoing feeds. Used to validate that the feed does not include claims outside the contracted coverage period.']
  dos_start_date date [note: 'Earliest date of service (DOS) for claims expected in this feed. Defines the historical coverage window for the feed and is used to validate that claims are within the contracted data scope.']
  effective_date date [note: 'Date on which this PBM feed agreement became or becomes active. Claims with a date of service on or after this date are expected to be included in the feed.']
  encryption_required boolean [note: 'Indicates whether feed files from this PBM must be encrypted (e.g., PGP) in transit. Required for HIPAA-compliant PHI transmission. Drives automated decryption steps in the ingestion pipeline.']
  expected_member_count varchar [note: 'Approximate number of eligible members expected to appear in this feed. Used as a baseline for feed volume validation; significant deviations trigger data quality alerts.']
  feed_code varchar [note: 'Short alphanumeric code uniquely identifying this feed configuration within the PBM Claims Feed Ingestion Platform. Used in ETL pipeline routing and file naming conventions.']
  feed_name varchar [note: 'Human-readable name identifying this PBM feed configuration, typically combining the division name and PBM name (e.g., \'Acme Corp - CVS Caremark Pharmacy Claims\'). Used in UI and reporting.']
  feed_status varchar [note: 'Current operational lifecycle status of this PBM feed. Active feeds are receiving and processing claim extracts. Suspended feeds are temporarily halted. Terminated feeds are permanently closed.']
  feed_type varchar [note: 'Classification of the data content delivered by this feed. Pharmacy claim feeds carry NCPDP-standard Rx claim transactions. Medical claim feeds carry HIPAA 837 transactions.']
  file_delimiter varchar [note: 'Character used to separate fields in delimited feed files (e.g., pipe \'|\', comma \',\', tab). Null for non-delimited formats such as fixed-width or XML. Required for ETL parsing configuration.']
  file_encoding varchar [note: 'Character encoding standard used in the PBM feed files. UTF-8 is the modern default; legacy PBM systems may deliver ISO-8859-1 or ASCII-encoded files requiring transformation.']
  file_format varchar [note: 'Technical file format of the claim extract delivered by the PBM. Fixed-width and delimited (CSV/pipe) are legacy PBM formats; EDI 835/837 are HIPAA-standard transaction formats.']
  file_naming_pattern varchar [note: 'Expected filename pattern or regex for incoming feed files from this PBM (e.g., \'ACME_CVS_{YYYYMMDD}.txt\'). Used by the ingestion platform to identify, validate, and route incoming files.']
  includes_medical_claims boolean [note: 'Indicates whether this feed includes medical claims in addition to pharmacy claims. True for integrated PBM/medical feeds used in total cost of care (TCOC) analysis.']
  includes_rebate_data boolean [note: 'Indicates whether this feed includes manufacturer rebate or DIR (Direct and Indirect Remuneration) data alongside claim transactions. Relevant for pass-through PBM contract auditing.']
  is_pass_through boolean [note: 'Indicates whether the PBM contract for this feed operates on a pass-through (transparent) pricing model. Pass-through feeds require additional spread and rebate reconciliation analytics.']
  last_file_received_date date [note: 'Date on which the most recent feed file was successfully received from the PBM. Used for feed monitoring, SLA tracking, and alerting when expected files are not delivered on schedule.']
  last_successful_load_date date [note: 'Date on which the most recent feed file was successfully ingested and loaded into the data lakehouse. Distinct from receipt date; a file may be received but fail validation before loading.']
  lookback_days varchar [note: 'Number of days of historical claims included in each feed extract. PBMs may include a rolling lookback window to capture late-arriving adjustments and reversals (e.g., 90 days for DIR reconciliation).']
  normalization_profile varchar [note: 'Name of the ETL normalization mapping profile applied to this feed during ingestion. Each PBM has a unique field layout; the profile maps source fields to the PillarRx canonical claim schema.']
  notes varchar [note: 'Free-text field for operational notes about this PBM feed configuration, such as known data quirks, PBM-specific field mappings, historical issues, or onboarding context captured during client setup.']
  pbm_client_code varchar [note: 'The client or group identifier assigned by the PBM to identify the division or employer group in the PBM\'s system. Used for feed routing, file validation, and claim matching.']
  pbm_contact_email varchar [note: 'Email address of the primary PBM technical or account contact for this feed. Used for feed delivery notifications, issue resolution, and schema change communications.']
  pbm_contact_name varchar [note: 'Name of the primary PBM account representative or technical contact responsible for this data feed. Used for issue escalation and feed configuration changes.']
  pbm_group_code varchar [note: 'The benefit group identifier used by the PBM to segment members within the employer plan. Corresponds to the RxGroup field in pharmacy claim routing and is used to scope claim extracts.']
  pgp_key_reference varchar [note: 'Reference identifier for the PGP public key used to decrypt incoming feed files from this PBM. The actual key material is stored in the secrets vault; this field holds the key alias or fingerprint.']
  rx_bin varchar [note: 'Six-digit Bank Identification Number (BIN) used to route pharmacy claims to the correct PBM processor at the point of sale. A key identifier for validating that claims in this feed belong to the correct PBM.']
  rx_pcn varchar [note: 'Processor Control Number (PCN) used in conjunction with RxBIN to route pharmacy claims to the correct PBM sub-processor or plan. Validates claim routing for this feed.']
  schema_version varchar [note: 'Version identifier of the PBM feed file layout or API schema in use (e.g., \'3.2\', \'5.0.1\'). PBMs periodically update their extract formats; version tracking enables backward-compatible ingestion.']
  sftp_host varchar [note: 'Hostname or IP address of the SFTP server from which PillarRx retrieves feed files for this PBM connection. Confidential infrastructure detail used by the ETL ingestion platform.']
  sftp_path varchar [note: 'Remote directory path on the SFTP server where the PBM deposits claim extract files for this feed. Used by the automated ingestion job to locate and retrieve files.']
  sftp_username varchar [note: 'Username credential used to authenticate to the PBM SFTP server for this feed. Stored as a reference; actual credentials are managed in a secrets vault per SOC 2 controls.']
  termination_date date [note: 'Date on which this PBM feed agreement ends. Null for open-ended feeds. Claims with a date of service after this date should not be expected from this feed.']
  updated_timestamp timestamp [note: 'Timestamp when this PBM feed configuration record was last modified. Used for change tracking, audit logging, and detecting configuration drift in the ingestion platform.']

  Note: 'Master record for a data feed/source connection by which PillarRx receives pharmacy (and medical) claim extracts for a specific Division from a specific PBM.'
}

Table division.engagement {
  engagement_id varchar [pk, note: 'Unique surrogate identifier for a consulting engagement scoped to a Division. Primary key for the division_engagement entity.']
  division_id varchar [note: 'Reference to the Division within the Company > Division > Client hierarchy that owns this consulting engagement.']
  division_pbm_contract_id varchar [note: 'Foreign key linking to division.division_pbm_contract. Business justification: Links an engagement to a specific PBM contract when the engagement is contract-specific (e.g., single-contract audit).']
  account_manager varchar [note: 'Full name of the PillarRx account manager responsible for the client relationship associated with this engagement.']
  actual_end_date date [note: 'The date the engagement was actually closed or completed, which may differ from the contractual end_date due to extensions or early termination.']
  analysis_period_end date [note: 'End date of the pharmacy claims or data analysis window for this engagement. Defines the claims date-of-service (DOS) range included in deliverables.']
  analysis_period_start date [note: 'Start date of the pharmacy claims or data analysis window for this engagement. May differ from the engagement start_date (e.g., retrospective audits).']
  audit_finding_count varchar [note: 'Number of audit findings identified during a PBM audit engagement. Populated upon completion of audit work; null for non-audit engagements.']
  contract_value decimal(18,2) [note: 'Total contracted consulting fee value for this engagement in USD. Used for revenue recognition, billing, and NetSuite/Brown & Brown Finance GL posting.']
  cost_center_code varchar [note: 'Cost center code in NetSuite to which internal labor and overhead costs for this engagement are allocated. Supports financial reporting and profitability analysis.']
  created_timestamp timestamp [note: 'Timestamp when this division_engagement record was first created in the data platform. Supports audit trail and data lineage requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this engagement (e.g., USD). PillarRx operates primarily in USD.']
  data_received_date date [note: 'Date on which the required PBM claims data or eligibility files were received from the client or PBM, enabling analysis to begin.']
  deliverable_count varchar [note: 'Total number of formal deliverables (reports, analyses, presentations) committed under this engagement per the SOW. Used for progress tracking.']
  end_date date [note: 'Contractual or operational end date on which the consulting engagement is scheduled to conclude. Null for open-ended engagements.']
  engagement_name varchar [note: 'Human-readable name or title of the consulting engagement (e.g., \'FY2024 PBM Audit – Acme Corp Division\'). Used in reporting and client deliverables.']
  engagement_number varchar [note: 'Externally-known alphanumeric identifier for the consulting engagement, used in client communications, SOWs, and invoicing. Sourced from Salesforce CRM.']
  engagement_status varchar [note: 'Current lifecycle state of the consulting engagement. Drives workflow routing, billing eligibility, and reporting inclusion.']
  engagement_type varchar [note: 'Classification of the engagement by delivery model: recurring (ongoing retainer), project (defined scope/timeline), or ad_hoc (one-time request).']
  estimated_savings decimal(18,2) [note: 'Estimated dollar savings identified for the client through this engagement (e.g., audit recoveries, rebate variances, formulary optimization). Raw estimate, not guaranteed.']
  fee_structure varchar [note: 'Billing model governing how consulting fees are calculated and invoiced for this engagement (e.g., flat fee, PMPM, milestone-based).']
  gl_account_code varchar [note: 'General Ledger (GL) account code in NetSuite used to post consulting fee revenue for this engagement. Supports Brown & Brown Finance SOX controls.']
  is_cap_management boolean [note: 'Indicates whether this engagement includes Copay Assistance Program (CAP) management via the PAX application. True = CAP management in scope.']
  is_pbm_audit boolean [note: 'Indicates whether this engagement includes a PBM audit service line (contract guarantee reconciliation, discount/rebate/dispensing-fee audit). True = audit in scope.']
  is_rebate_reconciliation boolean [note: 'Indicates whether this engagement includes rebate reconciliation (manufacturer and PBM rebate audit and pass-through verification). True = rebate reconciliation in scope.']
  is_tcoc_integration boolean [note: 'Indicates whether this engagement integrates medical claims data for Total Cost of Care (TCOC) analysis. True = medical claims feed in scope.']
  kickoff_date date [note: 'Date of the formal kickoff meeting with the client for this engagement. Marks the transition from contracting to active delivery.']
  last_review_date date [note: 'Date of the most recent internal or client-facing review or status meeting for this engagement. Used for engagement health monitoring.']
  lead_consultant varchar [note: 'Full name of the PillarRx consultant who is the primary owner and accountable lead for this engagement. Used for workload tracking and client communications.']
  member_count varchar [note: 'Number of covered members in scope for this engagement at the time of initiation. Used for PMPM fee calculation and benchmarking normalization.']
  next_milestone_date date [note: 'Target date for the next scheduled deliverable or milestone in the engagement timeline. Supports proactive project management and client communication.']
  notes varchar [note: 'Free-text field for internal notes, special instructions, or context relevant to this engagement. Not shared externally in deliverables.']
  pbm_scope varchar [note: 'Comma-separated list of PBM(s) in scope for this engagement (e.g., CVS Caremark, Optum Rx, Express Scripts). Drives claims data extraction and audit targeting.']
  pmpm_rate decimal(10,4) [note: 'Consulting fee rate expressed as a Per Member Per Month (PMPM) dollar amount. Applicable only when fee_structure = pmpm. Used for invoice calculation.']
  priority varchar [note: 'Business priority level assigned to this engagement, used for resource allocation and scheduling within the consulting team.']
  realized_savings decimal(18,2) [note: 'Actual dollar savings confirmed and realized by the client as a result of this engagement. Populated post-implementation; distinct from estimated_savings.']
  salesforce_opportunity_code varchar [note: 'Identifier of the corresponding Opportunity record in Salesforce CRM. Enables cross-system traceability between CRM pipeline and the data warehouse engagement record.']
  service_line varchar [note: 'Primary consulting service line delivered under this engagement. [ENUM-REF-CANDIDATE: pbm_audit|benchmarking|trend_analysis|cap_management|rebate_reconciliation|prior_auth_analysis|tcoc_integration — promote to reference product]']
  sow_reference varchar [note: 'Document reference number or title of the Statement of Work (SOW) governing this engagement. Links the data record to the executed legal/contractual document.']
  start_date date [note: 'Contractual or operational start date on which the consulting engagement becomes active and work may commence.']
  updated_timestamp timestamp [note: 'Timestamp when this division_engagement record was most recently modified. Used for incremental ETL processing and change detection in the Silver layer.']

  Note: 'Master record for a consulting engagement scoped to a Division (and optionally a specific service line: PBM audit, benchmarking, trend analysis, copay assistance management, rebate reconciliation).'
}

Table division.reconciliation_deliverable {
  reconciliation_deliverable_id varchar [pk, note: 'Unique surrogate identifier for the reconciliation deliverable record. Primary key for this entity.']
  company_pbm_id varchar [note: 'Reference to the PBM (e.g., CVS Caremark, Optum Rx, Express Scripts) whose contract guarantees or rebate payments are subject to this reconciliation.']
  consulting_fee_id varchar [note: 'Reference to the consulting fee record associated with this deliverable for NetSuite/Brown & Brown Finance billing and GL reconciliation.']
  employer_id varchar [note: 'Reference to the employer client for whom this reconciliation deliverable was produced within the Company > Division > Client hierarchy.']
  engagement_id varchar [note: 'Reference to the division-level consulting engagement under which this reconciliation deliverable was produced.']
  pbm_contract_id varchar [note: 'Reference to the PBM contract record whose guarantee terms are being audited in this reconciliation deliverable.']
  pbm_guarantee_result_id varchar [note: 'Reference to the primary PBM guarantee result record (discount, dispensing fee, or rebate guarantee) tied to this deliverable. Nullable when deliverable covers rebate-only reconciliation.']
  rebate_payment_id varchar [note: 'Reference to the rebate payment record reconciled within this deliverable. Nullable when deliverable covers guarantee-only audit outcomes.']
  actual_amount decimal(18,2) [note: 'The actual dollar amount delivered by the PBM for the audit period as determined by PillarRx claims analysis. Compared against guaranteed_amount to compute variance.']
  audit_period_end_date date [note: 'End date of the claims or payment period covered by this reconciliation deliverable. Paired with audit_period_start_date to define the full audit window.']
  audit_period_start_date date [note: 'Start date of the claims or payment period covered by this reconciliation deliverable. Defines the scope of the PBM audit or rebate reconciliation window.']
  awp_discount_actual_pct decimal(8,4) [note: 'Actual AWP discount percentage achieved by the PBM for the audit period as computed from normalized claims data. Compared against awp_discount_guaranteed_pct.']
  awp_discount_guaranteed_pct decimal(8,4) [note: 'Contractually guaranteed AWP discount percentage for the audit period. Compared against awp_discount_actual_pct to identify brand or generic discount shortfalls.']
  claim_count_audited varchar [note: 'Total number of pharmacy claims included in the audit scope for this reconciliation deliverable. Supports per-claim rate calculations and audit completeness validation.']
  client_name varchar [note: 'Name of the employer client for whom this deliverable was produced. Denormalized for reporting. Confidential as it identifies a specific consulting client relationship.']
  client_response_due_date date [note: 'Deadline by which the client must accept, dispute, or respond to the reconciliation deliverable findings. Drives consulting engagement SLA tracking.']
  created_timestamp timestamp [note: 'Timestamp when this reconciliation deliverable record was first created in the system. Used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this deliverable. Typically USD for PillarRx employer plan clients.']
  deliverable_engagement_fk varchar [note: 'FK to division.division_engagement.division_engagement_id — Every deliverable is produced under an engagement; required to close the accountability loop and attribute recovery amounts.']
  deliverable_number varchar [note: 'Externally-visible business identifier for this reconciliation deliverable, used in client communications, audit reports, and Salesforce CRM tracking.']
  deliverable_status varchar [note: 'Current workflow state of the reconciliation deliverable. [ENUM-REF-CANDIDATE: draft|in_review|pending_client|delivered|accepted|disputed|closed — promote to reference product]']
  deliverable_type varchar [note: 'Classification of the reconciliation deliverable by audit scope. [ENUM-REF-CANDIDATE: pbm_audit|rebate_reconciliation|guarantee_audit|spread_analysis|dir_reconciliation|combined — promote to reference product]']
  dispensing_fee_actual decimal(10,4) [note: 'Actual average dispensing fee per claim billed by the PBM during the audit period. Compared against dispensing_fee_guaranteed to identify fee overcharges.']
  dispensing_fee_guaranteed decimal(10,4) [note: 'Contractually guaranteed dispensing fee per claim for the audit period. Compared against actual dispensing fees billed by the PBM to identify overcharges.']
  dispute_amount decimal(18,2) [note: 'Dollar amount formally disputed by the PBM or client in response to this reconciliation deliverable findings. Nullable when no dispute has been raised.']
  dispute_reason varchar [note: 'Free-text or coded explanation of the basis for the dispute raised against this reconciliation deliverable. Captured for audit trail and resolution tracking.']
  dispute_status varchar [note: 'Current status of any formal dispute raised against the PBM findings in this deliverable. Tracks dispute lifecycle from submission through resolution.']
  division_engagement_fk varchar [note: 'FK to division.division_engagement.division_engagement_id — Each client-facing deliverable is produced under a specific consulting engagement; closes the accountability loop.']
  engagement_fk varchar [note: 'FK to division.division_engagement.division_engagement_id — Each deliverable is produced under a consulting engagement; FK closes the accountability loop.']
  guarantee_type varchar [note: 'Category of PBM contractual guarantee being reconciled. [ENUM-REF-CANDIDATE: awp_discount|dispensing_fee|rebate|mac|ger|ber|dir — promote to reference product]']
  guaranteed_amount decimal(18,2) [note: 'The contractually guaranteed dollar amount the PBM committed to deliver for the audit period (e.g., guaranteed rebate total or guaranteed effective rate savings).']
  is_pass_through boolean [note: 'Indicates whether the PBM contract under audit operates on a pass-through (transparent) pricing model. Affects how spread and rebate reconciliation logic is applied.']
  issued_date date [note: 'The date on which the reconciliation deliverable was formally issued and transmitted to the client. Principal business event date for this transaction.']
  notes varchar [note: 'Free-text field for analyst notes, caveats, or contextual commentary on the reconciliation deliverable findings. Not used for structured data.']
  rebate_actual_pmpm decimal(10,4) [note: 'Actual rebate amount on a per-member-per-month basis for the audit period as reconciled from PBM remittance data. Compared against rebate_guaranteed_pmpm.']
  rebate_guaranteed_pmpm decimal(10,4) [note: 'Contractually guaranteed rebate amount on a per-member-per-month basis for the audit period. Key PBM performance benchmark metric.']
  recovery_amount decimal(18,2) [note: 'Dollar amount recovered or credited to the client as a result of this reconciliation deliverable. May be less than variance_amount if partially disputed or settled.']
  report_file_reference varchar [note: 'Path or URI to the reconciliation report document (PDF, Excel) stored in the document management system or data lakehouse. Enables direct access to the client-facing artifact.']
  resolution_date date [note: 'Date on which the reconciliation deliverable dispute or open finding was formally resolved between PillarRx, the client, and the PBM.']
  salesforce_opportunity_code varchar [note: 'Salesforce CRM opportunity or case identifier linked to this reconciliation deliverable for consulting engagement tracking and client relationship management.']
  total_drug_spend decimal(18,2) [note: 'Aggregate plan drug spend across all claims in the audit scope for this deliverable. Used as the denominator for rebate-as-percent-of-spend and AWP discount calculations.']
  updated_timestamp timestamp [note: 'Timestamp when this reconciliation deliverable record was last modified. Supports change tracking and audit trail requirements.']
  variance_amount decimal(18,2) [note: 'Dollar difference between guaranteed_amount and actual_amount (guaranteed minus actual). Positive value indicates a shortfall owed to the client by the PBM.']
  variance_pct decimal(8,4) [note: 'Variance expressed as a percentage of the guaranteed amount. Enables benchmarking of PBM performance shortfalls across clients and audit periods.']

  Note: 'Transactional record capturing a client-facing reconciliation/audit deliverable produced under a division_engagement, tying one or more pbm_guarantee_result and/or rebate_payment reconciliation outcomes to an accountable consulting output.'
}


