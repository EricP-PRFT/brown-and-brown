// --- Tables ---

Table program.accumulator_program {
  accumulator_program_id bigint [pk, note: 'Surrogate primary key for accumulator program.']
  savings_program_id bigint [note: 'Foreign key to the parent savings program.']
  pbm_assignment_id bigint [note: 'ADD column program.accumulator_program.pbm_assignment_id (BIGINT) as FK to client.pbm_assignment.pbm_assignment_id. ADD column program.accumulator_program.pbm_assignment_id (BIGINT) FK to client.pbm_assignment.pbm_assignment_id.']
  client_id bigint [note: 'ADD column program.accumulator_program.client_id (BIGINT) as FK to client.employer.employer_id. ADD column program.accumulator_program.client_id (BIGINT) FK to client.employer.employer_id.']
  employer_id bigint [note: '']
  division_id bigint [note: '']
  accumulator_type varchar [note: 'Type of accumulator or maximizer arrangement.']
  applicable_drug_list varchar [note: 'Drug list scope the program applies to.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  effective_end_date date [note: 'End date of the records effective period for Type-2 history.']
  effective_start_date date [note: 'Start date of the records effective period for Type-2 history.']
  is_current boolean [note: 'Indicates whether this is the current version of the record.']
  manufacturer_assistance_counts_toward_deductible boolean [note: 'Indicates whether manufacturer assistance counts toward the member deductible.']
  manufacturer_assistance_counts_toward_oop boolean [note: 'Indicates whether manufacturer assistance counts toward member out-of-pocket.']
  maximizer_vendor_name varchar [note: 'Name of the maximizer vendor administering the program.']
  state_override_required boolean [note: 'Indicates whether a state-level override is required.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Copay accumulator and maximizer rules governing how manufacturer assistance counts toward member deductible and out-of-pocket.'
}

Table program.alternative_funding_program {
  alternative_funding_program_id bigint [pk, note: 'Surrogate primary key for alternative funding program.']
  savings_program_id bigint [note: 'Foreign key to the parent savings program.']
  client_id bigint [note: 'ADD column program.alternative_funding_program.client_id (BIGINT) as FK to client.employer.employer_id. ADD column program.alternative_funding_program.client_id (BIGINT) FK to client.employer.employer_id.']
  employer_id bigint [note: '']
  afp_vendor_name varchar [note: 'Name of the alternative funding program vendor.']
  applicable_drug_list varchar [note: 'Drug list scope the program applies to.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  estimated_annual_savings decimal(14,2) [note: 'Estimated annual savings generated by the program.']
  funding_source varchar [note: 'Funding source used by the alternative funding program.']
  member_consent_required boolean [note: 'Indicates whether member consent is required.']
  program_end_date date [note: 'Date the program ends.']
  program_start_date date [note: 'Date the program becomes effective.']
  program_status varchar [note: 'Current lifecycle status of the program.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Third-party Alternative Funding Programs (AFPs) that redirect specialty drug procurement through manufacturer patient-assistance, charitable-foundation, international-sourcing, or copay-optimization channels to reduce plan-sponsor drug spend.'
}

Table program.charitable_assistance {
  charitable_assistance_id bigint [pk, note: 'Surrogate primary key for charitable assistance.']
  savings_program_id bigint [note: 'Foreign key to the parent savings program.']
  application_required boolean [note: 'Indicates whether a formal application is required.']
  assistance_type varchar [note: 'Type of charitable assistance provided.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  disease_state varchar [note: 'Disease state the assistance program targets.']
  foundation_name varchar [note: 'Name of the charitable foundation.']
  fund_status varchar [note: 'Current funding status of the assistance fund.']
  income_threshold_fpl_pct bigint [note: 'Income eligibility threshold as a percentage of the Federal Poverty Level.']
  insurance_requirement varchar [note: 'Insurance status required for eligibility.']
  max_annual_award decimal(10,2) [note: 'Maximum annual award the foundation provides.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Charitable foundation assistance programs that provide copay, premium, travel, or combined financial support to eligible members based on disease state and federal poverty level income thresholds.'
}

Table program.claim_savings_attribution {
  claim_savings_attribution_id bigint [pk, note: 'Surrogate primary key for claim savings attribution.']
  savings_program_id bigint [note: 'Reference to program.savings_program.savings_program_id.']
  rx_claim_id bigint [note: 'ADD column program.claim_savings_attribution.rx_claim_id (BIGINT) as FK to claim.rx_claim.rx_claim_id. ADD column program.claim_savings_attribution.rx_claim_id (BIGINT) FK to claim.rx_claim.rx_claim_id.']
  member_id bigint [note: '']
  attributed_savings_amount decimal(12,2) [note: 'Amount of savings attributed.']
  attribution_date date [note: 'Date the savings attribution was recorded.']
  attribution_type varchar [note: 'Type of savings attributed to the claim.']
  beneficiary varchar [note: 'Party that benefits from the attributed savings.']
  calculation_method varchar [note: 'Method used to calculate the attributed savings.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Claim-level decomposition attributing savings to rebates, copay assistance, 340B discounts, and other sources.'
}

