Table program.rebate_payment {
  actual_brand_effective_rate decimal [note: 'Actual realized brand effective rebate rate.']
  actual_generic_effective_rate decimal [note: 'Actual realized generic effective rebate rate.']
  admin_fee_amount decimal [note: 'Administrative fee deducted from the gross rebate.']
  brand_rebate_amount decimal [note: 'Portion of the rebate attributable to brand drugs.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  eligible_claim_count bigint [note: 'Count of claims eligible for the rebate payment.']
  generic_rebate_amount decimal [note: 'Portion of the rebate attributable to generic drugs.']
  gross_rebate_amount decimal [note: 'Gross rebate amount before admin fees.']
  net_rebate_amount decimal [note: 'Net rebate amount after admin fees.']
  payment_period_end date [note: 'End date of the rebate payment period.']
  payment_period_start date [note: 'Start date of the rebate payment period.']
  payment_received_date date [note: 'Date the rebate payment was received.']
  rebate_contract_id bigint [ref: > program.rebate_contract.rebate_contract_id, note: 'Foreign key to the parent rebate contract.']
  rebate_payment_id bigint [pk, note: 'Surrogate primary key for rebate payment.']
  rebate_per_claim decimal [note: 'Rebate amount allocated per eligible claim.']
  reconciliation_status varchar [note: 'Reconciliation status of the rebate payment.']
  specialty_rebate_amount decimal [note: 'Portion of the rebate attributable to specialty drugs.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
}

Table program.savings_program {
