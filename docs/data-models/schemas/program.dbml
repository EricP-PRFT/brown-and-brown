  Note: 'Reference table classifying savings programs into business categories such as manufacturer rebate, patient assistance, and accumulator or maximizer arrangements.'
}

Table program.rebate_contract {
  rebate_contract_id bigint [pk, note: 'Surrogate primary key for rebate contract.']
  savings_program_id bigint [note: 'Foreign key to the parent savings program.']
  division_id bigint [note: 'ADD column program.rebate_contract.division_id (BIGINT) as nullable FK to division.division.division_id (null means client-wide contract). ADD column program.rebate_contract.division_id (BIGINT) FK to division.division.division_id. Nullable']
  client_id bigint [note: 'ADD column program.rebate_contract.client_id (BIGINT) as FK to client.employer.employer_id. ADD column program.rebate_contract.client_id (BIGINT) FK to client.employer.employer_id.']
  pbm_assignment_id bigint [note: 'ADD column program.rebate_contract.pbm_assignment_id (BIGINT) as FK to client.pbm_assignment.pbm_assignment_id. ADD column program.rebate_contract.pbm_assignment_id (BIGINT) FK to client.pbm_assignment.pbm_assignment_id.']
  manufacturer_id bigint [note: 'ADD column program.rebate_contract.manufacturer_id (BIGINT) as nullable FK to drug.manufacturer.manufacturer_id (nullable for aggregator contracts). ADD column program.rebate_contract.manufacturer_id (BIGINT) FK to drug.manufacturer.manufac']
  contract_end_date date [note: 'Date the rebate contract ends.']
  contract_start_date date [note: 'Date the rebate contract begins.']
  contract_status varchar [note: 'Current status of the contract.']
  contract_type varchar [note: 'Type of rebate contract arrangement.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  effective_end_date date [note: 'End date of the records effective period for Type-2 history.']
  effective_start_date date [note: 'Start date of the records effective period for Type-2 history.']
  guaranteed_brand_effective_rate decimal(8,4) [note: 'Guaranteed brand effective rebate rate.']
  guaranteed_generic_effective_rate decimal(8,4) [note: 'Guaranteed generic effective rebate rate.']
  is_current boolean [note: 'Indicates whether this is the current version of the record.']
  pass_through_pct decimal(5,2) [note: 'Percentage of rebate value passed through to the plan sponsor.']
  rebate_aggregator_name varchar [note: 'Name of the rebate aggregator managing the contract.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Rebate contract terms negotiated with manufacturers or aggregators, including guaranteed effective rates and pass-through percentages.'
}

Table program.rebate_payment {
  rebate_payment_id bigint [pk, note: 'Surrogate primary key for rebate payment.']
  rebate_contract_id bigint [note: 'Foreign key to the parent rebate contract.']
  actual_brand_effective_rate decimal(8,4) [note: 'Actual realized brand effective rebate rate.']
  actual_generic_effective_rate decimal(8,4) [note: 'Actual realized generic effective rebate rate.']
  admin_fee_amount decimal(14,2) [note: 'Administrative fee deducted from the gross rebate.']
  brand_rebate_amount decimal(14,2) [note: 'Portion of the rebate attributable to brand drugs.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  eligible_claim_count bigint [note: 'Count of claims eligible for the rebate payment.']
  generic_rebate_amount decimal(14,2) [note: 'Portion of the rebate attributable to generic drugs.']
  gross_rebate_amount decimal(14,2) [note: 'Gross rebate amount before admin fees.']
  net_rebate_amount decimal(14,2) [note: 'Net rebate amount after admin fees.']
  payment_period_end date [note: 'End date of the rebate payment period.']
  payment_period_start date [note: 'Start date of the rebate payment period.']
  payment_received_date date [note: 'Date the rebate payment was received.']
  rebate_per_claim decimal(10,4) [note: 'Rebate amount allocated per eligible claim.']
  reconciliation_status varchar [note: 'Reconciliation status of the rebate payment.']
  specialty_rebate_amount decimal(14,2) [note: 'Portion of the rebate attributable to specialty drugs.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Actual rebate payments received per contract per period, with gross, admin fee, and net amounts and reconciliation status.'
}

Table program.savings_program {
  savings_program_id bigint [pk, note: 'Surrogate primary key for savings program.']
  anti_kickback_restricted boolean [note: 'Indicates whether the program is restricted under anti-kickback rules.']
  applicable_market_segment varchar [note: 'Market segment the program applies to.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  external_program_code varchar [note: 'Identifier for the program in an external source system.']
  program_description varchar [note: 'Narrative description of the program.']
  program_name varchar [note: 'Name of the savings program.']
  program_status varchar [note: 'Current lifecycle status of the program.']
  program_subtype varchar [note: 'Finer-grained subtype classification of the program.']
  sponsor_name varchar [note: 'Name of the sponsoring entity.']
  sponsor_type varchar [note: 'Type of entity sponsoring the program.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Master registry of all cost-saving and cost-sharing programs that reduce drug costs for members, plan sponsors, or both.'
}

// --- Relationships ---
// 33 relationships

// program.accumulator_program
Ref: program.accumulator_program.client_id > client.employer.employer_id
Ref: program.accumulator_program.division_id > division.division.division_id
Ref: program.accumulator_program.employer_id > client.employer.employer_id
Ref: program.accumulator_program.pbm_assignment_id > client.pbm_assignment.pbm_assignment_id
Ref: program.accumulator_program.savings_program_id > program.savings_program.savings_program_id

// program.alternative_funding_program
Ref: program.alternative_funding_program.client_id > client.employer.employer_id
Ref: program.alternative_funding_program.employer_id > client.employer.employer_id
Ref: program.alternative_funding_program.savings_program_id > program.savings_program.savings_program_id

// program.charitable_assistance
Ref: program.charitable_assistance.savings_program_id > program.savings_program.savings_program_id

// program.claim_savings_attribution
Ref: program.claim_savings_attribution.member_id > company.member.member_id
Ref: program.claim_savings_attribution.rx_claim_id > claim.rx_claim.rx_claim_id
Ref: program.claim_savings_attribution.savings_program_id > program.savings_program.savings_program_id

// program.contract_pharmacy_340b
Ref: program.contract_pharmacy_340b.covered_entity_340b_id > program.covered_entity_340b.covered_entity_340b_id

// program.copay_assistance_program
Ref: program.copay_assistance_program.manufacturer_id > drug.manufacturer.manufacturer_id
Ref: program.copay_assistance_program.ndc_id > drug.ndc.ndc_code
Ref: program.copay_assistance_program.savings_program_id > program.savings_program.savings_program_id

// program.covered_entity_340b
Ref: program.covered_entity_340b.employer_id > client.employer.employer_id
Ref: program.covered_entity_340b.savings_program_id > program.savings_program.savings_program_id

// program.government_benefit_rule
Ref: program.government_benefit_rule.savings_program_id > program.savings_program.savings_program_id

// program.member_accumulator_impact
Ref: program.member_accumulator_impact.accumulator_program_id > program.accumulator_program.accumulator_program_id
Ref: program.member_accumulator_impact.member_id > company.member.member_id

// program.member_copay_enrollment
Ref: program.member_copay_enrollment.copay_assistance_program_id > program.copay_assistance_program.copay_assistance_program_id
Ref: program.member_copay_enrollment.member_id > company.member.member_id

// program.patient_assistance_program
Ref: program.patient_assistance_program.manufacturer_id > drug.manufacturer.manufacturer_id
Ref: program.patient_assistance_program.ndc_id > drug.ndc.ndc_code
Ref: program.patient_assistance_program.savings_program_id > program.savings_program.savings_program_id

// program.program_type
Ref: program.program_type.savings_program_id > program.savings_program.savings_program_id

// program.rebate_contract
Ref: program.rebate_contract.client_id > client.employer.employer_id
Ref: program.rebate_contract.division_id > division.division.division_id
Ref: program.rebate_contract.manufacturer_id > drug.manufacturer.manufacturer_id
Ref: program.rebate_contract.pbm_assignment_id > client.pbm_assignment.pbm_assignment_id
Ref: program.rebate_contract.savings_program_id > program.savings_program.savings_program_id

// program.rebate_payment
Ref: program.rebate_payment.rebate_contract_id > program.rebate_contract.rebate_contract_id
