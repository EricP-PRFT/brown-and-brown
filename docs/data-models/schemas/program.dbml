}

Table program.government_benefit_rule {
  government_benefit_rule_id bigint [pk, note: 'Surrogate primary key for government benefit rule.']
  savings_program_id bigint [note: 'Foreign key to the parent savings program.']
  annual_oop_cap decimal(10,2) [note: 'Annual out-of-pocket cap mandated by the rule.']
  benefit_phase varchar [note: 'Benefit phase the rule governs.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  legislative_source varchar [note: 'Legislative source authorizing the rule.']
  manufacturer_discount_pct decimal(5,2) [note: 'Mandated manufacturer discount percentage.']
  market_segment varchar [note: 'Government market segment the rule applies to.']
  member_coinsurance_pct decimal(5,2) [note: 'Member coinsurance percentage in the benefit phase.']
  monthly_cost_cap decimal(10,2) [note: 'Monthly cost cap mandated by the rule.']
  plan_liability_pct decimal(5,2) [note: 'Plan liability percentage in the benefit phase.']
  rule_effective_date date [note: 'Date the rule becomes effective.']
  rule_expiration_date date [note: 'Date the rule expires.']
  rule_name varchar [note: 'Name of the government benefit rule.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Government-mandated cost-sharing rules for Medicare Part D, Medicaid, VA, TRICARE, and IHP market segments used to model member out-of-pocket liability and plan financial exposure.'
}

Table program.member_accumulator_impact {
  member_accumulator_impact_id bigint [pk, note: 'Surrogate primary key for member accumulator impact.']
  accumulator_program_id bigint [note: 'Foreign key to the parent accumulator program.']
  member_id bigint [note: 'ADD column program.member_accumulator_impact.member_id (BIGINT) as FK to company.member.member_id. ADD column program.member_accumulator_impact.member_id (BIGINT) FK to company.member.member_id.']
  assistance_credited_to_deductible decimal(10,2) [note: 'Assistance amount credited to the member deductible.']
