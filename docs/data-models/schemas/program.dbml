  copay_cliff_date date [note: 'Date the member hits the copay cliff when assistance is exhausted.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  member_true_oop_spend decimal(10,2) [note: 'Members true out-of-pocket spend after accumulator treatment.']
  total_manufacturer_assistance_received decimal(10,2) [note: 'Total manufacturer assistance received in the benefit year.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Per-member per-benefit-year tracking of manufacturer assistance credited to or excluded from member accumulators.'
}

