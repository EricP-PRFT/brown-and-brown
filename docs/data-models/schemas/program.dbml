  manufacturer_assistance_counts_toward_deductible boolean [note: 'Indicates whether manufacturer assistance counts toward the member deductible.']
  manufacturer_assistance_counts_toward_oop boolean [note: 'Indicates whether manufacturer assistance counts toward member out-of-pocket.']
  maximizer_vendor_name varchar [note: 'Name of the maximizer vendor administering the program.']
  pbm_assignment_id bigint [note: 'ADD column program.accumulator_program.pbm_assignment_id (BIGINT) as FK to client.pbm_assignment.pbm_assignment_id. ADD column program.accumulator_program.pbm_assignment_id (BIGINT) FK to client.pb...']
  // cross-domain ref: pbm_assignment_id -> client.pbm_assignment.pbm_assignment_id
  savings_program_id bigint [ref: > program.savings_program.savings_program_id, note: 'Foreign key to the parent savings program.']
  state_override_required boolean [note: 'Indicates whether a state-level override is required.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
}

