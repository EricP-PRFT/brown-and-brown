Ref: division.prior_auth_request.division_id > division.division.division_id
Ref: division.prior_auth_request.employer_id > client.employer.employer_id
Ref: division.prior_auth_request.linked_rx_claim_id > claim.rx_claim.rx_claim_id
Ref: division.prior_auth_request.ndc_id > drug.ndc.ndc_id
Ref: division.prior_auth_request.prior_auth_rule_id > division.prior_auth_rule.prior_auth_rule_id
Ref: division.rebate_contract.division_pbm_contract_id > division.division_pbm_contract.division_pbm_contract_id
Ref: division.rebate_contract.employer_id > client.employer.employer_id
Ref: division.rebate_contract.manufacturer_id > drug.manufacturer.manufacturer_id
Ref: division.rebate_contract.pbm_contract_id > client.pbm_contract.pbm_contract_id
Ref: division.rebate_payment.company_pbm_id > company.company_pbm.company_pbm_id
Ref: division.rebate_payment.division_id > division.division.division_id
Ref: division.rebate_payment.employer_id > client.employer.employer_id
Ref: division.rebate_payment.pbm_contract_id > client.pbm_contract.pbm_contract_id
Ref: division.rebate_payment.primary_rebate_contract_id > division.rebate_contract.rebate_contract_id
Ref: division.rebate_payment.rebate_contract_id > division.rebate_contract.rebate_contract_id
Ref: division.pbm_feed.company_pbm_id > company.company_pbm.company_pbm_id
Ref: division.pbm_feed.division_id > division.division.division_id
Ref: division.pbm_feed.pbm_contract_id > client.pbm_contract.pbm_contract_id
Ref: division.engagement.division_id > division.division.division_id
Ref: division.engagement.division_pbm_contract_id > division.division_pbm_contract.division_pbm_contract_id
Ref: division.reconciliation_deliverable.company_pbm_id > company.company_pbm.company_pbm_id
Ref: division.reconciliation_deliverable.consulting_fee_id > company.consulting_fee.consulting_fee_id
Ref: division.reconciliation_deliverable.employer_id > client.employer.employer_id
Ref: division.reconciliation_deliverable.engagement_id > division.engagement.engagement_id
Ref: division.reconciliation_deliverable.pbm_contract_id > client.pbm_contract.pbm_contract_id
Ref: division.reconciliation_deliverable.pbm_guarantee_result_id > division.pbm_guarantee_result.pbm_guarantee_result_id
Ref: division.reconciliation_deliverable.rebate_payment_id > division.rebate_payment.rebate_payment_id

